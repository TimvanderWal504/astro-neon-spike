---
// Organizer/admin view: passcode-gated (AD-5), unredacted trip state (AD-2).
// Dynamic, on-demand rendered — no getStaticPaths needed under output:
// 'server' when prerender is false. Story 4 implemented the passcode gate;
// story 5 fills the real chapter-toggle UI into the authenticated view,
// fetched unredacted via getTripState (never redactTripState).
export const prerender = false;

import { SESSION_COOKIE_NAME, verifySession } from '../../lib/admin-auth';
import { getTripState, type TripState } from '../../lib/trip-state';
import {
  buildScheduleFromChapters,
  getOrganizerGuide,
  mapsSearchUrl,
  telHref,
  type OrganizerGuide,
} from '../../lib/organizer-guide';

const { trip } = Astro.params;

// Config read lazily, request-time — never module scope. If unset, the
// session can never verify, so the page fails closed to the passcode form
// (which itself 500s on submit via the login route's own config gate).
const cookieSigningSecret = process.env.COOKIE_SIGNING_SECRET;
const sessionCookie = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const isAuthenticated = Boolean(
  cookieSigningSecret && verifySession(sessionCookie, cookieSigningSecret),
);

// Unredacted per AD-2 ("organizer always sees everything") — only fetched
// once authenticated, and only when the route actually has a trip param. A
// thrown DB/content error is logged and kept distinct from "no such trip"
// (tripLoadFailed) so the two never render the same misleading message —
// matching the fail-gracefully convention used by toggle.ts/login.ts without
// conflating "unknown trip" with "transient server error".
let tripState: TripState | null = null;
let tripLoadFailed = false;
if (isAuthenticated && trip) {
  try {
    tripState = await getTripState(trip);
  } catch (err) {
    console.error(`admin.astro: getTripState(${trip}) failed:`, err);
    tripLoadFailed = true;
  }
}
if (isAuthenticated && trip && !tripState && !tripLoadFailed) {
  Astro.response.status = 404;
}

// Draaiboek tab: the content-only organizerGuide (never part of TripState —
// see content.config.ts), falling back to a schedule derived from the
// unredacted chapters when a trip has no authored runbook.
let organizerGuide: OrganizerGuide | null = null;
if (tripState) {
  try {
    organizerGuide = await getOrganizerGuide(tripState.slug);
  } catch (err) {
    console.error(`admin.astro: getOrganizerGuide(${tripState.slug}) failed:`, err);
  }
}
const draaiboek = organizerGuide?.runbook.length
  ? organizerGuide.runbook
  : tripState
    ? buildScheduleFromChapters(tripState.chapters)
    : [];
const chaptersById = new Map(tripState?.chapters.map((chapter) => [chapter.id, chapter]));
// Every distinct address in the draaiboek, with what happens there.
const addresses = new Map<string, string[]>();
for (const item of draaiboek.flatMap((day) => day.items)) {
  if (!item.location) continue;
  addresses.set(item.location, [...(addresses.get(item.location) ?? []), item.title]);
}
const startDateLabel = tripState
  ? new Date(tripState.startDate).toLocaleDateString('nl-NL', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : '';

// Defense-in-depth: this response is cookie-personalized (authenticated or
// not) and must never be cached by any intermediary, even though nothing
// currently opts it into caching.
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — {trip} — MoapMoap Vriendenweekend</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: #0a0d0c;
        color: #f4f1ea;
        font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      main {
        width: 100%;
        display: flex;
        justify-content: center;
      }
      /* Top-aligned once logged in, so switching tabs of different heights
         doesn't make the card jump around vertically. */
      body:has([data-authenticated]) {
        align-items: flex-start;
      }
      .mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }
      .admin-card {
        width: 100%;
        max-width: 400px;
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 28px;
      }
      .admin-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #9a9a91;
        margin: 0 0 8px;
      }
      .admin-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-weight: 500;
        font-size: 24px;
        margin: 0 0 20px;
      }
      .admin-field-label {
        display: block;
        font-size: 13px;
        color: #c9c6bc;
        margin: 0 0 8px;
      }
      .admin-input {
        width: 100%;
        background: rgba(244, 241, 234, 0.06);
        border: 1px solid rgba(244, 241, 234, 0.16);
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 15px;
        color: #f4f1ea;
        font-family: inherit;
      }
      .admin-input:focus {
        outline: none;
        border-color: #f4f1ea;
      }
      .admin-submit {
        width: 100%;
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        border: none;
        background: #f4f1ea;
        color: #0a0d0c;
        font-family: inherit;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
      }
      .admin-submit:disabled {
        opacity: 0.6;
        cursor: default;
      }
      .admin-error {
        margin: 12px 0 0;
        font-size: 13px;
        color: #e07a5f;
      }
      .admin-error[hidden] {
        display: none;
      }
      .admin-placeholder-copy {
        font-size: 15px;
        line-height: 1.6;
        color: #e5e2d9;
        margin: 0;
      }
      .admin-card-wide {
        max-width: 640px;
      }
      .chapter-list {
        list-style: none;
        margin: 24px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .chapter-row {
        border: 1px solid rgba(244, 241, 234, 0.09);
        border-radius: 16px;
        padding: 18px 20px;
        background: rgba(244, 241, 234, 0.02);
      }
      .chapter-row-main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }
      .chapter-row-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 4px;
      }
      .chapter-row-title {
        font-weight: 600;
        font-size: 15px;
      }
      .chapter-tag {
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        white-space: nowrap;
        background: rgba(244, 241, 234, 0.06);
        color: #9a9a91;
      }
      .chapter-tag[data-unlocked='true'] {
        background: rgba(227, 166, 74, 0.13);
        color: var(--accent, #e3a64a);
      }
      .chapter-meta {
        color: #9a9a91;
        font-size: 13px;
        margin: 0;
      }
      .chapter-toggle {
        flex: 0 0 auto;
        width: 44px;
        height: 26px;
        border-radius: 999px;
        border: none;
        position: relative;
        cursor: pointer;
        padding: 0;
        background: rgba(244, 241, 234, 0.15);
      }
      .chapter-toggle:focus-visible {
        outline: 2px solid #f4f1ea;
        outline-offset: 2px;
      }
      .chapter-toggle[data-unlocked='true'] {
        background: var(--accent, #e3a64a);
      }
      .chapter-toggle:disabled {
        opacity: 0.6;
        cursor: default;
      }
      .chapter-toggle-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: #0a0d0c;
        transition: left 0.2s ease;
      }
      .chapter-toggle[data-unlocked='true'] .chapter-toggle-thumb {
        left: 21px;
      }
      .always-on-badge {
        flex: 0 0 auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: #9a9a91;
        padding: 6px 10px;
        border: 1px solid rgba(244, 241, 234, 0.12);
        border-radius: 999px;
      }
      .chapter-row-error {
        margin: 10px 0 0;
        font-size: 12px;
        color: #e07a5f;
      }
      .chapter-row-error[hidden] {
        display: none;
      }
      .admin-tabs {
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 12px;
        background: rgba(244, 241, 234, 0.03);
      }
      .admin-tab {
        flex: 1 1 0;
        min-width: 0;
        padding: 10px 8px;
        border: none;
        border-radius: 9px;
        background: transparent;
        color: #9a9a91;
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .admin-tab:hover {
        color: #f4f1ea;
      }
      .admin-tab[aria-selected='true'] {
        background: rgba(244, 241, 234, 0.1);
        color: #f4f1ea;
      }
      .admin-tab:focus-visible {
        outline: 2px solid #f4f1ea;
        outline-offset: 2px;
      }
      .admin-panel[hidden] {
        display: none;
      }
      .admin-panel:focus-visible {
        outline: none;
      }
      .notify-section {
        margin-top: 24px;
      }
      .notify-section-divided {
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(244, 241, 234, 0.1);
      }
      .notify-intro,
      .schedule-intro {
        font-size: 14px;
        line-height: 1.55;
        color: #c9c6bc;
        margin: 0 0 20px;
      }
      .schedule-intro {
        margin-top: 24px;
      }
      .schedule-start {
        color: #f4f1ea;
      }
      .schedule-day {
        margin-top: 28px;
      }
      .schedule-day-label {
        font-size: 12px;
        font-weight: 400;
        color: var(--accent, #e3a64a);
      }
      .schedule-list,
      .guide-notes,
      .guide-links {
        list-style: none;
        margin: 12px 0 0;
        padding: 0;
      }
      .schedule-stop {
        display: grid;
        grid-template-columns: 52px 1fr;
        gap: 12px;
        padding: 14px 0;
        border-top: 1px solid rgba(244, 241, 234, 0.07);
      }
      .schedule-stop:first-child {
        border-top: none;
        padding-top: 4px;
      }
      .schedule-clock {
        font-size: 13px;
        color: #f4f1ea;
        padding-top: 1px;
      }
      .schedule-body {
        min-width: 0;
      }
      .schedule-description {
        margin: 4px 0 0;
        font-size: 14px;
        line-height: 1.55;
        color: #c9c6bc;
        white-space: pre-line;
      }
      .schedule-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 8px;
      }
      .schedule-owner {
        margin: 8px 0 0;
        font-size: 13px;
        color: #e5e2d9;
      }
      .schedule-owner .mono {
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #9a9a91;
        margin-right: 6px;
      }
      .schedule-location {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 10px;
        font-size: 13px;
        color: #f4f1ea;
        text-decoration: none;
        border-bottom: 1px solid rgba(244, 241, 234, 0.25);
      }
      .schedule-location:hover {
        border-bottom-color: var(--accent, #e3a64a);
      }
      .schedule-link-hint {
        font-size: 11px;
        color: var(--accent, #e3a64a);
      }
      .guide-notes li {
        position: relative;
        padding: 0 0 10px 16px;
        font-size: 14px;
        line-height: 1.55;
        color: #e5e2d9;
      }
      .guide-notes li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.62em;
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--accent, #e3a64a);
      }
      .guide-links {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .guide-links a {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 12px 14px;
        border: 1px solid rgba(244, 241, 234, 0.09);
        border-radius: 12px;
        background: rgba(244, 241, 234, 0.02);
        color: #f4f1ea;
        text-decoration: none;
        overflow-wrap: anywhere;
      }
      .guide-links a:hover {
        border-color: rgba(244, 241, 234, 0.22);
      }
      .guide-link-label {
        font-size: 14px;
        font-weight: 500;
      }
      .guide-phone {
        margin-left: 6px;
        font-size: 13px;
        font-weight: 400;
        color: var(--accent, #e3a64a);
        white-space: nowrap;
      }
      .guide-link-note {
        font-size: 13px;
        color: #9a9a91;
      }
      .notify-form-field {
        margin-top: 14px;
      }
      .notify-form-field:first-child {
        margin-top: 0;
      }
      textarea.admin-input {
        resize: vertical;
        min-height: 88px;
      }
      .admin-success {
        margin: 12px 0 0;
        font-size: 13px;
        color: var(--accent, #e3a64a);
      }
      .admin-success[hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <main>
      {
        isAuthenticated ? (
          <div
            class="admin-card admin-card-wide"
            data-authenticated
            style={tripState ? `--accent: ${tripState.accentColor}` : undefined}
          >
            <p class="admin-label mono">Admin — {trip}</p>
            <h1 class="admin-title">Ingelogd.</h1>
            {tripState ? (
              <>
              <div class="admin-tabs" role="tablist" aria-label="Admin-onderdelen" data-tablist>
                <button type="button" class="admin-tab" role="tab" id="tab-draaiboek" aria-controls="panel-draaiboek" aria-selected="true" data-tab="draaiboek">Draaiboek</button>
                <button type="button" class="admin-tab" role="tab" id="tab-onthullen" aria-controls="panel-onthullen" aria-selected="false" tabindex="-1" data-tab="onthullen">Onthullen</button>
                <button type="button" class="admin-tab" role="tab" id="tab-meldingen" aria-controls="panel-meldingen" aria-selected="false" tabindex="-1" data-tab="meldingen">Meldingen</button>
              </div>
              <section class="admin-panel" role="tabpanel" id="panel-onthullen" aria-labelledby="tab-onthullen" data-tab-panel="onthullen" hidden>
              <ul class="chapter-list" aria-label="Hoofdstukken">
                {tripState.chapters.map((chapter) => (
                  <li class="chapter-row" data-chapter-row>
                    <div class="chapter-row-main">
                      <div class="chapter-row-info">
                        <div class="chapter-row-heading">
                          <span class="chapter-row-title" data-chapter-title>{chapter.title}</span>
                          {!chapter.alwaysUnlocked && (
                            <span
                              class="chapter-tag mono"
                              data-chapter-tag
                              data-unlocked={chapter.unlocked ? 'true' : 'false'}
                            >
                              {chapter.unlocked ? 'Onthuld' : 'Op slot'}
                            </span>
                          )}
                        </div>
                        <p class="chapter-meta">
                          {[
                            chapter.kind === 'cinematic' ? 'Cinematisch' : 'Knap',
                            chapter.time,
                            chapter.location,
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                      </div>
                      {chapter.alwaysUnlocked ? (
                        <div class="always-on-badge">altijd aan</div>
                      ) : (
                        <button
                          type="button"
                          class="chapter-toggle"
                          data-chapter-toggle
                          data-chapter-id={chapter.id}
                          data-trip-slug={tripState.slug}
                          data-unlocked={chapter.unlocked ? 'true' : 'false'}
                          aria-pressed={chapter.unlocked ? 'true' : 'false'}
                          aria-label={`${chapter.title} ${chapter.unlocked ? 'vergrendelen' : 'ontgrendelen'}`}
                        >
                          <span class="chapter-toggle-thumb" aria-hidden="true" />
                        </button>
                      )}
                    </div>
                    <p
                      class="chapter-row-error mono"
                      hidden
                      role="alert"
                      aria-live="polite"
                      data-chapter-error
                    />
                  </li>
                ))}
                <li class="chapter-row" data-chapter-row>
                  <div class="chapter-row-main">
                    <div class="chapter-row-info">
                      <div class="chapter-row-heading">
                        <span class="chapter-row-title">Paklijst</span>
                      </div>
                      <p class="chapter-meta">Altijd zichtbaar, vanaf dag één.</p>
                    </div>
                    <div class="always-on-badge">altijd aan</div>
                  </div>
                </li>
              </ul>
              </section>
              <section class="admin-panel" role="tabpanel" id="panel-meldingen" aria-labelledby="tab-meldingen" data-tab-panel="meldingen" hidden>
              <div class="notify-section" data-notify-section>
                <p class="notify-intro">
                  Stuur een pushmelding naar iedereen die meldingen heeft aangezet. Het onthullen
                  van een hoofdstuk stuurt zelf al automatisch een melding.
                </p>
                <p class="admin-label mono">Melding versturen</p>
                <form data-notify-form data-trip-slug={tripState.slug}>
                  <div class="notify-form-field">
                    <label class="admin-field-label" for="notify-title">Titel</label>
                    <input
                      class="admin-input"
                      type="text"
                      id="notify-title"
                      name="title"
                      maxlength="100"
                      required
                      data-notify-title
                    />
                  </div>
                  <div class="notify-form-field">
                    <label class="admin-field-label" for="notify-body">Bericht</label>
                    <textarea
                      class="admin-input"
                      id="notify-body"
                      name="body"
                      rows="4"
                      maxlength="500"
                      required
                      data-notify-body
                    />
                  </div>
                  <button class="admin-submit" type="submit" data-notify-submit>
                    Versturen
                  </button>
                  <p
                    class="admin-error mono"
                    hidden
                    role="alert"
                    aria-live="polite"
                    data-notify-error
                  />
                  <p
                    class="admin-success mono"
                    hidden
                    role="status"
                    aria-live="polite"
                    data-notify-success
                  />
                </form>
              </div>
              {/* Announces a new deploy with one tap. Deliberately not
                  automatic on every push to main: most deploys are small
                  fixes nobody needs to be pinged about. Tapping the push
                  opens the trip page fresh, which is the new version; an
                  already-open page gets the same push broadcast and shows
                  its own update banner (see index.astro). */}
              <div class="notify-section notify-section-divided" data-update-section>
                <p class="admin-label mono">Website-update aankondigen</p>
                <p class="admin-placeholder-copy">
                  Stuurt iedereen met meldingen aan een pushmelding dat er een nieuwe versie van de site staat.
                  Doe dit pas nadat de deploy live is.
                </p>
                <button
                  class="admin-submit"
                  type="button"
                  data-update-announce
                  data-trip-slug={tripState.slug}
                >
                  Update aankondigen
                </button>
                <p class="admin-error mono" hidden role="alert" aria-live="polite" data-update-error />
                <p class="admin-success mono" hidden role="status" aria-live="polite" data-update-success />
              </div>
              </section>
              <section class="admin-panel" role="tabpanel" id="panel-draaiboek" aria-labelledby="tab-draaiboek" data-tab-panel="draaiboek">
                <p class="schedule-intro">
                  Vertrek <span class="schedule-start">{startDateLabel}</span>. Het volledige
                  draaiboek, ook wat nog op slot staat — alleen zichtbaar voor jou.
                </p>
                {draaiboek.map((day) => (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">{day.label}</h2>
                    <ol class="schedule-list">
                      {day.items.map((item) => {
                        const chapter = item.chapterId ? chaptersById.get(item.chapterId) : undefined;
                        return (
                          <li class="schedule-stop">
                            <span class="schedule-clock mono">{item.time ?? ''}</span>
                            <div class="schedule-body">
                              <div class="chapter-row-heading">
                                <span class="chapter-row-title">{item.title}</span>
                                {chapter && !chapter.alwaysUnlocked && (
                                  <span
                                    class="chapter-tag mono"
                                    data-schedule-tag={chapter.id}
                                    data-unlocked={chapter.unlocked ? 'true' : 'false'}
                                  >
                                    {chapter.unlocked ? 'Onthuld' : 'Op slot'}
                                  </span>
                                )}
                              </div>
                              {item.detail && <p class="schedule-description">{item.detail}</p>}
                              {(item.location || item.url) && (
                                <div class="schedule-links">
                                  {item.location && (
                                    <a
                                      class="schedule-location"
                                      href={mapsSearchUrl(item.location)}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >
                                      <span>{item.location}</span>
                                      <span class="schedule-link-hint mono" aria-hidden="true">Maps ↗</span>
                                    </a>
                                  )}
                                  {item.url && (
                                    <a
                                      class="schedule-location"
                                      href={item.url}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >
                                      <span>{new URL(item.url).hostname.replace(/^www\./, '')}</span>
                                      <span class="schedule-link-hint mono" aria-hidden="true">↗</span>
                                    </a>
                                  )}
                                </div>
                              )}
                              {item.owner && (
                                <p class="schedule-owner">
                                  <span class="mono">Wie</span> {item.owner}
                                </p>
                              )}
                            </div>
                          </li>
                        );
                      })}
                    </ol>
                  </div>
                ))}
                {organizerGuide && organizerGuide.notes.length > 0 && (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">Goed om te weten</h2>
                    <ul class="guide-notes">
                      {organizerGuide.notes.map((note) => (
                        <li>{note}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {organizerGuide && organizerGuide.contacts.length > 0 && (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">Telefoonnummers</h2>
                    <ul class="guide-links">
                      {organizerGuide.contacts.map((contact) => (
                        <li>
                          <a href={telHref(contact.phone)}>
                            <span class="guide-link-label">
                              {contact.label} <span class="guide-phone mono">{contact.phone}</span>
                            </span>
                            {contact.note && <span class="guide-link-note">{contact.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {organizerGuide?.infoBlocks.map((block) => (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">{block.label}</h2>
                    <ul class="guide-notes">
                      {block.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
                {organizerGuide && organizerGuide.links.length > 0 && (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">Handige links</h2>
                    <ul class="guide-links">
                      {organizerGuide.links.map((link) => (
                        <li>
                          <a href={link.url} target="_blank" rel="noopener noreferrer">
                            <span class="guide-link-label">{link.label} <span aria-hidden="true">↗</span></span>
                            {link.note && <span class="guide-link-note">{link.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {addresses.size > 0 && (
                  <div class="schedule-day">
                    <h2 class="admin-label mono schedule-day-label">Alle adressen</h2>
                    <ul class="guide-links">
                      {[...addresses].map(([location, titles]) => (
                        <li>
                          <a href={mapsSearchUrl(location)} target="_blank" rel="noopener noreferrer">
                            <span class="guide-link-label">{location} <span aria-hidden="true">↗</span></span>
                            <span class="guide-link-note">{titles.join(' · ')}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </section>
              </>
            ) : tripLoadFailed ? (
              <p class="admin-placeholder-copy">
                Er ging iets mis bij het laden. Probeer de pagina te vernieuwen.
              </p>
            ) : (
              <p class="admin-placeholder-copy">Trip "{trip}" niet gevonden.</p>
            )}
          </div>
        ) : (
          <div class="admin-card">
            <p class="admin-label mono">Admin — {trip}</p>
            <h1 class="admin-title">Toegangscode</h1>
            <form data-passcode-form>
              <label class="admin-field-label" for="passcode">
                Voer de toegangscode in
              </label>
              <input
                class="admin-input"
                type="password"
                id="passcode"
                name="passcode"
                autocomplete="current-password"
                required
                data-passcode-input
              />
              <button class="admin-submit" type="submit" data-passcode-submit>
                Ontgrendelen
              </button>
              <p
                class="admin-error mono"
                hidden
                role="alert"
                aria-live="polite"
                data-passcode-error
              />
            </form>
          </div>
        )
      }
    </main>

    <script>
      const form = document.querySelector('[data-passcode-form]');
      const errorEl = document.querySelector('[data-passcode-error]');
      const input = document.querySelector('[data-passcode-input]');
      const submitBtn = document.querySelector('[data-passcode-submit]');

      function showError(message: string): void {
        if (!(errorEl instanceof HTMLElement)) return;
        errorEl.textContent = message;
        errorEl.hidden = false;
      }

      function hideError(): void {
        if (!(errorEl instanceof HTMLElement)) return;
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        hideError();
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

        try {
          const passcode = input instanceof HTMLInputElement ? input.value : '';
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ passcode }),
          });

          if (res.status === 200) {
            window.location.reload();
            return;
          }

          if (res.status === 429) {
            showError('Te veel pogingen. Probeer het over een tijdje opnieuw.');
            return;
          }

          const payload = await res.json().catch(() => null);
          showError(
            (payload && typeof payload.error === 'string' && payload.error) ||
              'Onjuiste toegangscode.',
          );
        } catch (err) {
          console.error(err);
          showError('Er ging iets mis. Probeer het opnieuw.');
        } finally {
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
        }
      });
    </script>

    <script>
      // WAI-ARIA tabs: arrow/Home/End move between tabs, active tab mirrored
      // in the URL hash so a reload (e.g. after login) keeps you in place.
      const tabs = [...document.querySelectorAll('[data-tab]')].filter(
        (el): el is HTMLButtonElement => el instanceof HTMLButtonElement,
      );

      function selectTab(name: string, focus = false): void {
        const target = tabs.find((tab) => tab.dataset.tab === name);
        if (!target) return;
        for (const tab of tabs) {
          const selected = tab === target;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
          const panel = document.querySelector(`[data-tab-panel="${tab.dataset.tab}"]`);
          if (panel instanceof HTMLElement) panel.hidden = !selected;
        }
        if (focus) target.focus();
        history.replaceState(null, '', `#${name}`);
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab.dataset.tab ?? ''));
        tab.addEventListener('keydown', (event) => {
          const last = tabs.length - 1;
          const next =
            event.key === 'ArrowRight' ? (index === last ? 0 : index + 1)
            : event.key === 'ArrowLeft' ? (index === 0 ? last : index - 1)
            : event.key === 'Home' ? 0
            : event.key === 'End' ? last
            : null;
          if (next === null) return;
          event.preventDefault();
          selectTab(tabs[next].dataset.tab ?? '', true);
        });
      });

      const initialTab = window.location.hash.slice(1);
      if (tabs.some((tab) => tab.dataset.tab === initialTab)) selectTab(initialTab);
    </script>

    <script>
      const toggles = document.querySelectorAll('[data-chapter-toggle]');

      function setRowUnlocked(button: HTMLButtonElement, unlocked: boolean): void {
        const state = unlocked ? 'true' : 'false';
        button.setAttribute('aria-pressed', state);
        button.dataset.unlocked = state;

        const row = button.closest('[data-chapter-row]');

        // Keep the accessible name in sync with the *next* action the button
        // will perform — otherwise a screen reader keeps announcing "unlock"
        // after the chapter is already unlocked (and vice versa).
        const titleEl = row?.querySelector('[data-chapter-title]');
        const title = titleEl instanceof HTMLElement ? titleEl.textContent : '';
        button.setAttribute(
          'aria-label',
          `${title ?? ''} ${unlocked ? 'vergrendelen' : 'ontgrendelen'}`.trim(),
        );

        // Same tag appears in this row and in the Draaiboek tab.
        const tags = [
          row?.querySelector('[data-chapter-tag]'),
          ...document.querySelectorAll(`[data-schedule-tag="${CSS.escape(button.dataset.chapterId ?? '')}"]`),
        ];
        for (const tag of tags) {
          if (tag instanceof HTMLElement) {
            tag.dataset.unlocked = state;
            tag.textContent = unlocked ? 'Onthuld' : 'Op slot';
          }
        }
      }

      function showRowError(button: HTMLButtonElement, message: string): void {
        const row = button.closest('[data-chapter-row]');
        const errorEl = row?.querySelector('[data-chapter-error]');
        if (errorEl instanceof HTMLElement) {
          errorEl.textContent = message;
          errorEl.hidden = false;
        }
      }

      function hideRowError(button: HTMLButtonElement): void {
        const row = button.closest('[data-chapter-row]');
        const errorEl = row?.querySelector('[data-chapter-error]');
        if (errorEl instanceof HTMLElement) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
      }

      toggles.forEach((el) => {
        if (!(el instanceof HTMLButtonElement)) return;

        el.addEventListener('click', async () => {
          const chapterId = el.dataset.chapterId;
          const tripSlug = el.dataset.tripSlug;
          if (!chapterId || !tripSlug) return;

          const previousUnlocked = el.getAttribute('aria-pressed') === 'true';
          const nextUnlocked = !previousUnlocked;

          hideRowError(el);
          el.disabled = true;

          try {
            const res = await fetch('/api/admin/toggle', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ tripSlug, chapterId, unlocked: nextUnlocked }),
            });

            const payload = await res.json().catch(() => null);

            if (
              res.status === 200 &&
              payload &&
              payload.ok === true &&
              typeof payload.data?.unlocked === 'boolean'
            ) {
              setRowUnlocked(el, payload.data.unlocked);
            } else {
              setRowUnlocked(el, previousUnlocked);
              showRowError(
                el,
                (payload && typeof payload.error === 'string' && payload.error) ||
                  'Er ging iets mis. Probeer het opnieuw.',
              );
            }
          } catch (err) {
            console.error(err);
            setRowUnlocked(el, previousUnlocked);
            showRowError(el, 'Er ging iets mis. Probeer het opnieuw.');
          } finally {
            el.disabled = false;
          }
        });
      });
    </script>

    <script>
      // One POST /api/admin/notify round-trip, shared by the free-form
      // message below and the "Update aankondigen" button. Resolves to the
      // text to show the admin: which of the two elements it goes in is
      // `ok`.
      async function sendNotification(
        tripSlug: string,
        title: string,
        body: string,
      ): Promise<{ ok: boolean; message: string }> {
        try {
          const res = await fetch('/api/admin/notify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ tripSlug, title, body }),
          });

          const payload = await res.json().catch(() => null);

          if (res.status === 200 && payload && payload.ok === true) {
            const sent = typeof payload.data?.sent === 'number' ? payload.data.sent : 0;
            const failed = typeof payload.data?.failed === 'number' ? payload.data.failed : 0;
            // Nobody subscribed isn't an error, but "verstuurd naar 0"
            // read like one that went fine — say what actually happened.
            if (sent === 0 && failed === 0) {
              return { ok: true, message: 'Niemand heeft meldingen aanstaan, er is niets verstuurd.' };
            }
            if (sent === 0) {
              return {
                ok: false,
                message: `Versturen is mislukt voor alle ${failed} abonnee${failed === 1 ? '' : 's'}.`,
              };
            }
            const sentText =
              sent === 1 ? 'Melding verstuurd naar 1 abonnee' : `Melding verstuurd naar ${sent} abonnees`;
            return {
              ok: true,
              message: failed > 0 ? `${sentText}, ${failed} mislukt.` : `${sentText}.`,
            };
          }
          return {
            ok: false,
            message:
              (payload && typeof payload.error === 'string' && payload.error) ||
              'Er ging iets mis. Probeer het opnieuw.',
          };
        } catch (err) {
          console.error(err);
          return { ok: false, message: 'Er ging iets mis. Probeer het opnieuw.' };
        }
      }

      function showResult(
        errorEl: Element | null,
        successEl: Element | null,
        result: { ok: boolean; message: string } | null,
      ): void {
        for (const el of [errorEl, successEl]) {
          if (el instanceof HTMLElement) {
            el.hidden = true;
            el.textContent = '';
          }
        }
        if (!result) return;
        const target = result.ok ? successEl : errorEl;
        if (target instanceof HTMLElement) {
          target.textContent = result.message;
          target.hidden = false;
        }
      }

      const notifyForm = document.querySelector('[data-notify-form]');
      const notifyTitleInput = document.querySelector('[data-notify-title]');
      const notifyBodyInput = document.querySelector('[data-notify-body]');
      const notifySubmitBtn = document.querySelector('[data-notify-submit]');
      const notifyErrorEl = document.querySelector('[data-notify-error]');
      const notifySuccessEl = document.querySelector('[data-notify-success]');

      notifyForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        showResult(notifyErrorEl, notifySuccessEl, null);

        const tripSlug =
          notifyForm instanceof HTMLFormElement ? notifyForm.dataset.tripSlug : undefined;
        const title = notifyTitleInput instanceof HTMLInputElement ? notifyTitleInput.value.trim() : '';
        const body =
          notifyBodyInput instanceof HTMLTextAreaElement ? notifyBodyInput.value.trim() : '';

        if (!tripSlug || !title || !body) return;

        if (notifySubmitBtn instanceof HTMLButtonElement) notifySubmitBtn.disabled = true;
        const result = await sendNotification(tripSlug, title, body);
        showResult(notifyErrorEl, notifySuccessEl, result);
        if (result.ok && notifyForm instanceof HTMLFormElement) notifyForm.reset();
        if (notifySubmitBtn instanceof HTMLButtonElement) notifySubmitBtn.disabled = false;
      });

      const UPDATE_TITLE = 'De site is bijgewerkt';
      const UPDATE_BODY = 'Er staat een nieuwe versie klaar. Tik om hem te openen.';
      const updateButton = document.querySelector('[data-update-announce]');
      const updateErrorEl = document.querySelector('[data-update-error]');
      const updateSuccessEl = document.querySelector('[data-update-success]');

      updateButton?.addEventListener('click', async () => {
        if (!(updateButton instanceof HTMLButtonElement)) return;
        const tripSlug = updateButton.dataset.tripSlug;
        if (!tripSlug) return;
        // A push to everyone can't be taken back — one confirm instead of
        // letting a stray tap on a phone send it.
        if (!window.confirm('Pushmelding over de update naar iedereen sturen?')) return;

        showResult(updateErrorEl, updateSuccessEl, null);
        updateButton.disabled = true;
        const result = await sendNotification(tripSlug, UPDATE_TITLE, UPDATE_BODY);
        showResult(updateErrorEl, updateSuccessEl, result);
        updateButton.disabled = false;
      });
    </script>
  </body>
</html>
