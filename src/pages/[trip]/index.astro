    <!-- CHAPTER SLOTS — only id/order/kind drive this markup. Each slot
         stays display:none (see .chapter-slot) until client-side JS adds
         .is-unlocked, so a locked chapter has no visible trace at all —
         real content (title/time/location/description) is filled in only
         once the fetch of /api/trip/[slug] reports it unlocked, never
         embedded here. -->
    <div class="chapters">
      {
        chapterSlots.map((chapter) => {
          const isCinematic = chapter.kind === 'cinematic';
          return (
            <section
              class={`chapter-slot ${isCinematic ? 'cinematic-reveal' : 'reveal'}`}
              id={chapter.id}
              data-order={chapter.order}
              data-kind={chapter.kind}
            >
              <div class="chapter-index mono">{String(chapter.order).padStart(2, '0')}</div>
              {isCinematic ? (
                <div class="chapter-content">
                  <p class="chapter-meta ct-eyebrow">
                    <span data-field="time" /> <span data-field="location" />
                  </p>
                  <h2 class="chapter-title ct-title" data-field="title" />
                  <p class="chapter-description ct-copy" data-field="description" />
                  <button type="button" class="chapter-replay ct-cta" data-replay-target={chapter.id}>
                    Bekijk opnieuw
                  </button>
                </div>
              ) : (
                <div class="chapter-content">
                  <h2 class="chapter-title" data-field="title" />
                  <p class="chapter-meta">
                    <span data-field="time" /> <span data-field="location" />
                  </p>
                  <p class="chapter-description" data-field="description" />
                </div>
              )}
            </section>
          );
        })
      }
