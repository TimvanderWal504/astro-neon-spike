---
import { getCollection } from 'astro:content';
import { sortByOrder } from '../../lib/trip-state';

// Static shell per AD-1: only structure (nav, hero, chapter slot order,
// ambient viewfinder) is prerendered. A chapter's real content never enters
// this template — only `id`/`order`/`kind` may drive markup here; real
// title/time/location/description/svgVariant arrive client-side only, via
// the fetch of the (redacted) GET /api/trip/[slug] response (AD-2).
export const prerender = true;

// Required because this dynamic route is prerendered (AD-1): Astro needs to
// know which [trip] paths exist at build time.
export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({
    params: { trip: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;

// Only trip-level styling/routing fields and per-chapter id/order/kind are
// read here — never a chapter's real content fields (see note above).
const accentColor = trip.data.accentColor;
const startDate = trip.data.startDate;
const slug = trip.data.slug;
const chapterSlots = sortByOrder(trip.data.chapters).map((chapter) => ({
  id: chapter.id,
  order: chapter.order,
  kind: chapter.kind,
}));

// 8-digit hex-with-alpha strings (e.g. "#E3A64A24") for the ambient glow —
// computed here since CSS custom properties can't have hex digits appended
// to them in a stylesheet the way a template-string concatenation can.
const ambientGlowBackground = `radial-gradient(ellipse 70% 55% at 50% 10%, ${accentColor}24, transparent 62%), radial-gradient(ellipse 65% 55% at 88% 45%, ${accentColor}1a, transparent 60%), radial-gradient(ellipse 65% 55% at 8% 80%, ${accentColor}1a, transparent 60%)`;
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ameland Vriendenweekend</title>
    <style define:vars={{ accent: accentColor }}>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: #0a0d0c;
        color: #f4f1ea;
        font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
      }
      .mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }

      /* AMBIENT GLOW — one continuous light source for the whole scroll.
         Background is set inline (see body markup) since it needs
         hex-with-alpha strings, not a plain CSS custom property value. */
      .ambient-glow {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        mix-blend-mode: screen;
      }

      /* FIXED SCAN LAYER — ambient-only viewfinder wandering a faint Europe
         map (ported from design/ameland-weekend/Main.dc.html:276-324,184-189).
         Only the ambient loop is built here; the Bestemming-triggered
         zoom/dive sequence is story 6 and is intentionally not ported. */
      .fixed-scan-layer {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .fixed-scan-svg {
        width: min(82vw, 640px);
        height: min(82vw, 640px);
        overflow: visible;
        opacity: 0.13;
      }
      .fixed-scan-zoom {
        transform-origin: 38.125% 41.875%;
      }
      .fixed-scan-motion {
        animation: heroScanMove 16s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      .fixed-scan-scale {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroScanScale 16s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      .fixed-scan-dot {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroViewfinderPulse 2600ms ease-in-out infinite;
      }
      .fixed-scan-flash {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
      }
      .fixed-scan-caption {
        opacity: 0;
      }
      @keyframes heroScanMove {
        0% { transform: translate(180px, 580px); }
        20% { transform: translate(250px, 430px); }
        38% { transform: translate(380px, 480px); }
        54% { transform: translate(470px, 380px); }
        70% { transform: translate(305px, 335px); }
        84% { transform: translate(305px, 335px); }
        100% { transform: translate(180px, 580px); }
      }
      @keyframes heroScanScale {
        0% { transform: scale(1); }
        20% { transform: scale(1.1); }
        38% { transform: scale(0.95); }
        54% { transform: scale(1.08); }
        70% { transform: scale(1.2); }
        84% { transform: scale(1.2); }
        100% { transform: scale(1); }
      }
      @keyframes heroViewfinderPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.25); }
      }

      /* NAV */
      .nav {
        position: sticky;
        top: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        background: rgba(10, 13, 12, 0.72);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(244, 241, 234, 0.07);
      }
      .nav-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #9a9a91;
      }
      .nav-countdown {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #9a9a91;
      }

      /* HERO */
      .hero {
        min-height: calc(100dvh - 60px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 24px 64px;
        position: relative;
        z-index: 3;
      }
      .hero-days {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        line-height: 0.9;
        font-size: clamp(96px, 22vw, 220px);
        color: var(--accent);
        letter-spacing: -0.02em;
      }
      .hero-days-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #9a9a91;
        margin-top: 4px;
      }
      .hero-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-weight: 500;
        font-size: clamp(30px, 5.5vw, 48px);
        line-height: 1.18;
        letter-spacing: -0.005em;
        margin: 38px 0 14px;
        max-width: 15ch;
      }
      .hero-copy {
        font-size: 16px;
        line-height: 1.6;
        color: #c9c6bc;
        max-width: 38ch;
        margin: 0 0 32px;
      }

      /* CHAPTER SLOTS */
      .chapters {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 0 24px 96px;
        max-width: 640px;
        margin: 0 auto;
      }
      .chapter-slot {
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 28px;
        opacity: 1;
      }
      .chapter-slot[data-kind='knap'] {
        border-style: dashed;
      }
      .chapter-index {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        color: var(--accent);
      }
      .chapter-placeholder {
        margin: 10px 0 0;
        font-size: 15px;
        line-height: 1.55;
        color: #7d7c74;
      }
      .chapter-content {
        display: none;
      }
      .chapter-slot.is-unlocked .chapter-placeholder {
        display: none;
      }
      .chapter-slot.is-unlocked .chapter-content {
        display: block;
      }
      .chapter-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 22px;
        margin: 8px 0 6px;
      }
      .chapter-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: #9a9a91;
        margin: 0 0 10px;
      }
      .chapter-description {
        font-size: 15px;
        line-height: 1.6;
        color: #e5e2d9;
        white-space: pre-line;
      }

      @media (prefers-reduced-motion: reduce) {
        .fixed-scan-motion,
        .fixed-scan-scale,
        .fixed-scan-dot {
          animation: none;
        }
        .fixed-scan-layer {
          display: none;
        }
      }
    </style>
  </head>
  <body data-start={startDate} data-trip-slug={slug}>
    <div class="ambient-glow" style={`background:${ambientGlowBackground}`} aria-hidden="true"></div>

    <!-- Ambient-only viewfinder layer (ported, scan-loop mode only). -->
    <div class="fixed-scan-layer" aria-hidden="true">
      <svg class="fixed-scan-svg" viewBox="0 0 800 800">
        <g class="fixed-scan-zoom">
          <g class="fixed-scan-grid">
            <line x1="0" y1="100" x2="800" y2="100" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="200" x2="800" y2="200" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="300" x2="800" y2="300" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="400" x2="800" y2="400" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="500" x2="800" y2="500" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="600" x2="800" y2="600" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="0" y1="700" x2="800" y2="700" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="100" y1="0" x2="100" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="200" y1="0" x2="200" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="300" y1="0" x2="300" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="400" y1="0" x2="400" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="500" y1="0" x2="500" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="600" y1="0" x2="600" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="700" y1="0" x2="700" y2="800" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <circle cx="400" cy="400" r="360" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
            <circle cx="400" cy="400" r="260" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
            <circle cx="400" cy="400" r="160" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
          </g>
          <path d="M260,275 C330,245 410,250 470,268 C530,282 570,315 585,360 C598,405 580,455 545,495 C510,535 445,555 395,540 C345,528 305,500 275,465 C240,425 215,380 220,335 C222,310 235,290 260,275 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.55"/>
          <path d="M170,505 C215,480 275,488 295,520 C315,552 305,595 285,632 C265,668 225,690 185,675 C145,660 118,615 120,570 C122,545 140,520 170,505 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.55"/>
          <path d="M195,225 C228,232 250,265 246,305 C242,345 255,375 232,400 C210,420 182,405 172,368 C160,325 152,282 165,250 C172,235 182,227 195,225 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.55"/>
          <path d="M130,318 C150,322 158,348 148,368 C138,384 112,380 105,358 C100,340 112,320 130,318 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.5"/>
          <path d="M440,72 C480,58 520,80 535,125 C550,170 540,215 555,255 C562,275 540,282 518,268 C482,245 448,225 428,192 C408,158 402,110 418,88 C424,80 432,75 440,72 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.5"/>
          <path d="M410,272 C425,268 438,285 432,303 C427,318 410,320 402,305 C398,290 400,278 410,272 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.45"/>
          <path d="M470,478 C492,470 515,483 520,502 C526,528 545,548 538,575 C531,600 516,620 522,648 C526,668 514,688 495,690 C478,692 468,672 465,650 C460,618 456,585 452,552 C448,522 452,494 470,478 Z" fill="none" stroke={accentColor} stroke-width="1.4" opacity="0.45"/>

          <g class="fixed-scan-motion">
            <g class="fixed-scan-scale">
              <circle class="fixed-scan-flash" r="70" fill="none" stroke={accentColor} stroke-width="1"/>
              <line x1="-90" y1="0" x2="90" y2="0" stroke={accentColor} stroke-width="1"/>
              <line x1="0" y1="-90" x2="0" y2="90" stroke={accentColor} stroke-width="1"/>
              <circle r="46" fill="none" stroke={accentColor} stroke-width="1.3"/>
              <circle r="20" fill="none" stroke={accentColor} stroke-width="1.3"/>
              <circle class="fixed-scan-dot" r="2.6" fill={accentColor}/>
              <path d="M-90,-70 L-90,-90 L-70,-90" fill="none" stroke={accentColor} stroke-width="2" stroke-linecap="round"/>
              <path d="M70,-90 L90,-90 L90,-70" fill="none" stroke={accentColor} stroke-width="2" stroke-linecap="round"/>
              <path d="M90,70 L90,90 L70,90" fill="none" stroke={accentColor} stroke-width="2" stroke-linecap="round"/>
              <path d="M-70,90 L-90,90 L-90,70" fill="none" stroke={accentColor} stroke-width="2" stroke-linecap="round"/>
            </g>
          </g>
        </g>
      </svg>
      <div class="fixed-scan-caption mono">Locatie zoeken&hellip;</div>
    </div>

    <!-- NAV -->
    <div class="nav">
      <div class="nav-label">Ameland</div>
      <div class="nav-countdown">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span class="mono"><span data-days-left>&hellip;</span> dagen</span>
      </div>
    </div>

    <!-- HERO -->
    <div class="hero">
      <div class="hero-days" data-days-left>&hellip;</div>
      <div class="hero-days-label">dagen tot vertrek</div>
      <h1 class="hero-title">Nog niet alles is <em>verklapt</em>.</h1>
      <p class="hero-copy">De rest volgt hier, stuk voor stuk, zodra het zover is.</p>
    </div>

    <!-- CHAPTER SLOTS — only id/order/kind drive this markup. Real content
         (title/time/location/description) is filled in client-side, per
         chapter, only once the fetch of /api/trip/[slug] reports it
         unlocked. Never embedded here. -->
    <div class="chapters">
      {
        chapterSlots.map((chapter) => (
          <section class="chapter-slot" id={chapter.id} data-order={chapter.order} data-kind={chapter.kind}>
            <div class="chapter-index mono">{String(chapter.order).padStart(2, '0')}</div>
            <p class="chapter-placeholder" data-field="placeholder">
              Nog een verrassing onderweg.
            </p>
            <div class="chapter-content">
              <h2 class="chapter-title" data-field="title" />
              <p class="chapter-meta">
                <span data-field="time" /> <span data-field="location" />
              </p>
              <p class="chapter-description" data-field="description" />
            </div>
          </section>
        ))
      }
    </div>

    <script>
      // daysLeft is always computed fresh, client-side, from the static
      // `data-start` attribute — never baked in once at build time, so a
      // static build never goes stale (mirrors Main.dc.html's formula).
      const body = document.body;
      const startISO = body.dataset.start;
      const tripSlug = body.dataset.tripSlug;

      function computeDaysLeft(): number {
        const target = new Date(startISO ?? '');
        const now = new Date();
        return Math.max(0, Math.ceil((target.getTime() - now.getTime()) / 86400000));
      }

      function renderDaysLeft(): void {
        const daysLeft = String(computeDaysLeft());
        document.querySelectorAll('[data-days-left]').forEach((el) => {
          el.textContent = daysLeft;
        });
      }

      renderDaysLeft();

      // Merge real content into unlocked chapter slots via the redacted
      // trip-state API (AD-2). Locked chapters are never touched — they
      // keep their placeholder, exactly as the API left them.
      async function loadTripState(): Promise<void> {
        if (!tripSlug) return;
        try {
          const res = await fetch(`/api/trip/${encodeURIComponent(tripSlug)}`);
          const payload = await res.json();
          if (!payload.ok) return;

          const chapters = payload.data?.chapters ?? [];
          for (const chapter of chapters) {
            if (!chapter.unlocked) continue;
            const slot = document.getElementById(chapter.id);
            if (!slot) continue;

            slot.classList.add('is-unlocked');
            const titleEl = slot.querySelector('[data-field="title"]');
            if (titleEl) titleEl.textContent = chapter.title;
            const timeEl = slot.querySelector('[data-field="time"]');
            if (timeEl) timeEl.textContent = chapter.time ?? '';
            const locationEl = slot.querySelector('[data-field="location"]');
            if (locationEl) locationEl.textContent = chapter.location ?? '';
            const metaEl = slot.querySelector('.chapter-meta');
            if (metaEl instanceof HTMLElement) {
              metaEl.hidden = !chapter.time && !chapter.location;
            }
            const descEl = slot.querySelector('[data-field="description"]');
            if (descEl) descEl.textContent = chapter.description ?? '';
          }
        } catch (err) {
          console.error('Failed to load trip state', err);
        }
      }

      loadTripState();
    </script>
  </body>
</html>
