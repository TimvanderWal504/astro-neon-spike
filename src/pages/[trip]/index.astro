---
import { getCollection } from 'astro:content';
import { sortByOrder } from '../../lib/trip-state';

// Static shell per AD-1: only structure (nav, hero, chapter slot order,
// ambient viewfinder) is prerendered. A chapter's real content never enters
// this template — only `id`/`order`/`kind` may drive markup here; real
// title/time/location/description/svgVariant arrive client-side only, via
// the fetch of the (redacted) GET /api/trip/[slug] response (AD-2).
export const prerender = true;

// Required because this dynamic route is prerendered (AD-1): Astro needs to
// know which [trip] paths exist at build time.
export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({
    params: { trip: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;

// Only trip-level styling/routing fields and per-chapter id/order/kind are
// read here — never a chapter's real content fields (see note above).
const accentColor = trip.data.accentColor;
const startDate = trip.data.startDate;
const slug = trip.data.slug;
const chapterSlots = sortByOrder(trip.data.chapters).map((chapter) => ({
  id: chapter.id,
  order: chapter.order,
  kind: chapter.kind,
}));
// Static, non-gated content (AD-2: the packing-list section is exempt from
// chapter-content-gating) — safe to read directly here, unlike chapter
// title/time/location/description above.
const packingList = trip.data.packingList;

// 8-digit hex-with-alpha strings (e.g. "#E3A64A24") for the ambient glow —
// computed here since CSS custom properties can't have hex digits appended
// to them in a stylesheet the way a template-string concatenation can.
const ambientGlowBackground = `radial-gradient(ellipse 70% 55% at 50% 10%, ${accentColor}24, transparent 62%), radial-gradient(ellipse 65% 55% at 88% 45%, ${accentColor}1a, transparent 60%), radial-gradient(ellipse 65% 55% at 8% 80%, ${accentColor}1a, transparent 60%)`;

// Same hex-with-alpha technique as ambientGlowBackground above, used for the
// #installeren step-number circle backgrounds (ported from Main.dc.html's
// rgba(227,166,74,0.15), rebuilt from the trip's own accentColor so a
// different trip's accent isn't stuck showing Main.dc.html's default).
const installStepIconBg = `${accentColor}26`;
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MoapMoap Vriendenweekend</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0d0c" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MoapMoap" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style define:vars={{ accent: accentColor }}>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: #0a0d0c;
        color: #f4f1ea;
        font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
      }
      .mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }

      /* AMBIENT GLOW — one continuous light source for the whole scroll.
         Background is set inline (see body markup) since it needs
         hex-with-alpha strings, not a plain CSS custom property value. */
      .ambient-glow {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        mix-blend-mode: screen;
      }

      /* HERO MAP — Europe scan-loop viewfinder (ported from
         design/ameland-weekend/Main.dc.html:276-324,184-189), now scoped to
         the hero's right-hand pane instead of a page-wide fixed watermark,
         so it reads as a real visual rather than ambient background texture.
         Only the ambient loop is built here; the Bestemming-triggered
         zoom/dive sequence is story 6 and is intentionally not ported. */
      .hero-map {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 3;
      }
      .hero-map-svg {
        width: min(88vw, 560px);
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: visible;
        opacity: 0.3;
      }
      /* transform-origin is 47.468% 50.633% of the viewBox (see
         .hero-map-svg's viewBox="80 0 790 790" below, matched to the real
         Europe vector map's own coordinate space) — the point that maps
         back to absolute (455,400), the NL anchor used by the wander
         default position and fixedScanLockMove/-Scale keyframes. */
      .hero-map-zoom {
        transform-origin: 47.468% 50.633%;
      }
      /* Movement/scale are driven client-side (random walk, see script)
         rather than a fixed CSS keyframe loop, so the viewfinder wanders
         to a new point each cycle instead of repeating one fixed path. */
      .hero-map-motion {
        transition: transform 2.4s cubic-bezier(0.45, 0, 0.55, 1);
      }
      .hero-map-scale {
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 2.4s cubic-bezier(0.45, 0, 0.55, 1);
      }
      .hero-map-dot {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroViewfinderPulse 2600ms ease-in-out infinite;
      }
      .hero-map-flash {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
      }
      @keyframes heroViewfinderPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.25); }
      }

      /* HERO MAP — DIVE INSTANCE (story 6). Always-present, always
         position:fixed layer, invisible (opacity:0, pointer-events:none)
         until #bestemming becomes visible — then it fades in and plays the
         original fixedScanZoomSequence/fixedScanLockMove/fixedScanLockScale/
         fixedScanLockFlash keyframes (ported unchanged from
         Main.dc.html:165-229, targets renamed to this instance's classes).
         Reuses the ambient instance's coastline geometry via
         <use href="#europe-coastline">; never promotes .hero-map itself to
         position:fixed (would reflow .hero's flex layout). */
      .hero-map-dive {
        position: fixed;
        inset: 0;
        z-index: 50;
        opacity: 0;
        pointer-events: none;
        transition: opacity 500ms ease;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      body:has(#bestemming.is-visible) .hero-map-dive {
        opacity: 0.5;
      }
      .hero-map-dive-svg {
        width: min(82vw, 640px);
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: visible;
      }
      .hero-map-dive-zoom {
        transform-origin: 47.468% 50.633%;
      }
      .hero-map-dive-scale {
        transform-box: fill-box;
        transform-origin: center;
      }
      .hero-map-dive-flash {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
      }
      .hero-map-dive-dot {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroViewfinderPulse 2600ms ease-in-out infinite;
      }
      .fixed-scan-caption {
        opacity: 0;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, 86px);
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--accent);
        white-space: nowrap;
      }

      /* a dramatic hop between a few other countries before finally arriving on NL */
      @keyframes fixedScanLockMove {
        0%   { transform: translate(311px,230px); }
        30%  { transform: translate(554px,216px); }
        60%  { transform: translate(360px,402px); }
        85%  { transform: translate(455px,400px); }
        100% { transform: translate(455px,400px); }
      }
      @keyframes fixedScanLockScale {
        0%   { transform: scale(1); }
        30%  { transform: scale(1.15); }
        60%  { transform: scale(1.05); }
        85%  { transform: scale(1.25); }
        100% { transform: scale(1); }
      }
      @keyframes fixedScanLockFlash {
        0%   { opacity: 0; transform: scale(0.8); }
        50%  { opacity: 0.7; transform: scale(1.6); }
        100% { opacity: 0; transform: scale(2.2); }
      }
      /* Europe grows to fill the whole screen (0-20%), holds huge while the viewfinder hops between countries (20-78%), then dives through into the boat scene (78-100%) */
      @keyframes fixedScanZoomSequence {
        0%   { transform: scale(1); opacity: 1; }
        20%  { transform: scale(7); opacity: 1; }
        78%  { transform: scale(7); opacity: 1; }
        90%  { opacity: 0.45; }
        100% { transform: scale(28); opacity: 0; }
      }
      @keyframes fixedScanCaptionFade { 0% { opacity:0; } 10% { opacity:1; } 85% { opacity:1; } 100% { opacity:0; } }

      /* the instant #bestemming becomes visible, the dive layer plays: Europe fills the screen, the viewfinder hops between countries, then locks onto NL and dives through */
      body:has(#bestemming.is-visible) .hero-map-dive-zoom { animation: fixedScanZoomSequence 3700ms cubic-bezier(0.65,0,0.35,1) forwards; }
      body:has(#bestemming.is-visible) .hero-map-dive-motion { animation: fixedScanLockMove 2150ms cubic-bezier(0.45,0,0.55,1) 750ms forwards; }
      body:has(#bestemming.is-visible) .hero-map-dive-scale { animation: fixedScanLockScale 2150ms cubic-bezier(0.45,0,0.55,1) 750ms forwards; }
      body:has(#bestemming.is-visible) .hero-map-dive-flash { animation: fixedScanLockFlash 550ms cubic-bezier(0.16,1,0.3,1) 2500ms forwards; }
      body:has(#bestemming.is-visible) .fixed-scan-caption { animation: fixedScanCaptionFade 2900ms ease 0ms forwards; }

      /* HERO */
      .hero {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 24px 64px;
        position: relative;
        z-index: 3;
        gap: 40px;
      }
      .hero-text {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      @media (min-width: 900px) {
        .hero {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          text-align: left;
          padding: 0 4vw;
          gap: 0;
        }
        .hero-text {
          align-items: flex-start;
          flex: 0 1 480px;
        }
        .hero-map {
          flex: 1 1 auto;
          align-self: stretch;
        }
        .hero-map-svg {
          height: min(84dvh, 920px);
          width: auto;
          aspect-ratio: 1 / 1;
          max-width: 100%;
          opacity: 0.4;
        }
      }
      .hero-days {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        line-height: 0.9;
        font-size: clamp(96px, 22vw, 220px);
        color: var(--accent);
        letter-spacing: -0.02em;
      }
      .hero-days-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #9a9a91;
        margin-top: 4px;
      }
      .hero-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-weight: 500;
        font-size: clamp(30px, 5.5vw, 48px);
        line-height: 1.18;
        letter-spacing: -0.005em;
        margin: 38px 0 14px;
        max-width: 15ch;
      }
      .hero-copy {
        font-size: 16px;
        line-height: 1.6;
        color: #c9c6bc;
        max-width: 38ch;
        margin: 0 0 32px;
      }
      /* HERO CTA — ported from Main.dc.html:374, links down to #installeren. */
      .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 28px;
        border-radius: 999px;
        background: var(--accent);
        color: #0a0d0c;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
      }
      .hero-cta:hover {
        opacity: 0.8;
      }
      .hero-cta:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }

      /* REVEAL / CINEMATIC CHOREOGRAPHY — ported unchanged from
         Main.dc.html:37-108. `data-kind` on each .chapter-slot decides
         which reveal class server-side (cinematic -> cinematic-reveal,
         knap -> reveal); the shared IntersectionObserver (see script)
         adds .is-visible once per element. */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1), transform 700ms cubic-bezier(0.16,1,0.3,1);
      }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }
      .reveal-fade {
        opacity: 0;
        transition: opacity 900ms cubic-bezier(0.16,1,0.3,1);
      }
      .reveal-fade.is-visible { opacity: 1; }
      .cinematic-reveal {
        opacity: 0;
        transform: scale(1.06);
        filter: blur(14px);
        transition: opacity 1100ms cubic-bezier(0.16,1,0.3,1), transform 1300ms cubic-bezier(0.16,1,0.3,1), filter 1100ms cubic-bezier(0.16,1,0.3,1);
      }
      .cinematic-reveal.is-visible { opacity: 1; transform: scale(1); filter: blur(0); }
      /* bestemming's title/copy/cta arrive after the fixed dive layer (see .hero-map-dive) has filled the screen, hopped between countries, locked and dived through */
      #bestemming.is-visible .ct-eyebrow { transition-delay: 3700ms; }
      #bestemming.is-visible .ct-title { transition-delay: 3900ms; }
      #bestemming.is-visible .ct-copy { transition-delay: 4200ms; }
      #bestemming.is-visible .ct-cta { transition-delay: 4400ms; }

      /* staggered delay modifiers for individually-cascading elements (chips, timeline rows) */
      .reveal-d1 { transition-delay: 90ms; }
      .reveal-d2 { transition-delay: 180ms; }
      .reveal-d3 { transition-delay: 270ms; }
      .reveal-d4 { transition-delay: 360ms; }
      .reveal-d5 { transition-delay: 450ms; }

      /* cinematic text choreography - each piece moves on its own beat instead of one blob fade */
      .ct-eyebrow {
        opacity: 0;
        transform: translateX(-18px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1) 100ms, transform 700ms cubic-bezier(0.16,1,0.3,1) 100ms;
      }
      .cinematic-reveal.is-visible .ct-eyebrow { opacity: 1; transform: translateX(0); }
      .ct-title {
        opacity: 0;
        transform: translateY(34px) scale(0.98);
        transition: opacity 900ms cubic-bezier(0.16,1,0.3,1) 260ms, transform 900ms cubic-bezier(0.16,1,0.3,1) 260ms;
      }
      .cinematic-reveal.is-visible .ct-title { opacity: 1; transform: translateY(0) scale(1); }
      .ct-copy {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 800ms cubic-bezier(0.16,1,0.3,1) 520ms, transform 800ms cubic-bezier(0.16,1,0.3,1) 520ms;
      }
      .cinematic-reveal.is-visible .ct-copy { opacity: 1; transform: translateY(0); }
      .ct-cta {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1) 680ms, transform 700ms cubic-bezier(0.16,1,0.3,1) 680ms;
      }
      .cinematic-reveal.is-visible .ct-cta { opacity: 1; transform: translateY(0); }

      /* INSTALLEREN — ported from Main.dc.html:402-442. The toggle's
         sc-if/setState mechanism doesn't exist in this plain-script page:
         a `data-platform` attribute on #installeren (set by the click
         handlers in the script block) drives which button/steps block is
         shown via the attribute-selector pairs below, instead of adding or
         removing classes on each element individually. Renders statically
         at full opacity, deliberately with no .reveal/.cinematic-reveal
         class (story 1.6 scoped that system to chapter slots only). */
      .installeren {
        position: relative;
        z-index: 3;
        padding: 56px 24px 96px;
        max-width: 640px;
        margin: 0 auto;
      }
      .installeren-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 600;
        margin: 0 0 10px;
      }
      .installeren-copy {
        color: #c9c6bc;
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 28px;
        max-width: 44ch;
      }
      .installeren-buttons {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
      }
      .installeren-btn {
        flex: 1;
        padding: 11px;
        border-radius: 10px;
        border: 1px solid rgba(244, 241, 234, 0.18);
        background: transparent;
        color: #f4f1ea;
        font-weight: 600;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
      }
      #installeren[data-platform='android'] .installeren-btn[data-platform-btn='android'],
      #installeren[data-platform='ios'] .installeren-btn[data-platform-btn='ios'] {
        border-color: var(--accent);
        background: var(--accent);
        color: #0a0d0c;
      }
      .installeren-btn:hover {
        opacity: 0.8;
      }
      .installeren-btn:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .installeren-steps {
        display: none;
        flex-direction: column;
        gap: 16px;
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 22px;
      }
      #installeren[data-platform='android'] .installeren-steps[data-platform-steps='android'],
      #installeren[data-platform='ios'] .installeren-steps[data-platform-steps='ios'] {
        display: flex;
      }
      .installeren-step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }
      .installeren-step-num {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border-radius: 999px;
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
      }
      .installeren-step p {
        margin: 0;
        font-size: 14px;
        line-height: 1.55;
        color: #e5e2d9;
      }

      /* CHAPTER SLOTS */
      .chapters {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 24px;
        padding: 0 24px 96px;
        max-width: 640px;
        margin: 0 auto;
      }
      .chapter-slot {
        display: none;
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 28px;
      }
      .chapter-slot[data-kind='knap'] {
        border-style: dashed;
      }
      .chapter-slot.is-unlocked {
        display: block;
      }
      .chapter-index {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        color: var(--accent);
      }
      .chapter-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 22px;
        margin: 8px 0 6px;
      }
      .chapter-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: #9a9a91;
        margin: 0 0 10px;
      }
      .chapter-description {
        font-size: 15px;
        line-height: 1.6;
        color: #e5e2d9;
        white-space: pre-line;
      }
      .chapter-replay {
        display: inline-block;
        margin-top: 14px;
        padding: 0;
        border: none;
        background: none;
        font-family: 'JetBrains Mono', monospace;
        font-variant: small-caps;
        font-size: 12px;
        letter-spacing: 0.14em;
        color: #9a9a91;
        cursor: pointer;
      }
      .chapter-replay:hover {
        color: var(--accent);
      }
      .chapter-replay:focus-visible {
        color: var(--accent);
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }

      /* PAKLIJST — floating button + bottom-sheet overlay, ported from
         Main.dc.html:590-620 (mockup's sc-if/setState pseudo-framework ->
         plain DOM class/hidden toggling, story 7's approach). Renders
         unconditionally, independent of chapter lock state (AD-2). z-index
         must clear .hero-map-dive's z-index:50 (story 6) — the mockup's own
         50/60 values collide with it, so these go higher. */
      .packing-toggle {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 65;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border-radius: 999px;
        border: none;
        background: #f4f1ea;
        color: #0a0d0c;
        font-weight: 600;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.6);
      }
      .packing-toggle:hover {
        opacity: 0.85;
      }
      .packing-toggle:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-overlay {
        position: fixed;
        inset: 0;
        z-index: 75;
        background: rgba(5, 6, 6, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }
      .packing-overlay[hidden] {
        display: none;
      }
      .packing-sheet {
        width: 100%;
        max-width: 480px;
        max-height: 76dvh;
        overflow-y: auto;
        background: #12160f;
        border-radius: 24px 24px 0 0;
        border: 1px solid rgba(244, 241, 234, 0.1);
        padding: 28px 24px 32px;
      }
      .packing-sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
      }
      .packing-sheet-title {
        margin: 0;
        font-size: 19px;
        font-weight: 600;
      }
      .packing-close {
        background: none;
        border: none;
        color: #9a9a91;
        cursor: pointer;
        padding: 4px;
      }
      .packing-close:hover {
        color: #f4f1ea;
      }
      .packing-close:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-sheet-copy {
        color: #9a9a91;
        font-size: 13px;
        margin: 0 0 20px;
      }
      .packing-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .packing-item {
        border-bottom: 1px solid rgba(244, 241, 234, 0.08);
      }
      .packing-item:last-child {
        border-bottom: none;
      }
      .packing-item-label {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 2px;
        cursor: pointer;
      }
      .packing-checkbox {
        appearance: none;
        -webkit-appearance: none;
        flex: 0 0 auto;
        width: 22px;
        height: 22px;
        margin: 0;
        border-radius: 6px;
        border: 1px solid rgba(244, 241, 234, 0.3);
        background: transparent;
        position: relative;
        cursor: pointer;
      }
      .packing-checkbox:checked {
        background: var(--accent);
        border-color: var(--accent);
      }
      .packing-checkbox:checked::after {
        content: '';
        position: absolute;
        left: 7px;
        top: 3px;
        width: 5px;
        height: 10px;
        border: solid #0a0d0c;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
      }
      .packing-checkbox:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-item-text {
        font-size: 14px;
        color: #e5e2d9;
      }
      .packing-item-label:has(.packing-checkbox:checked) .packing-item-text {
        color: #7d7c74;
        text-decoration: line-through;
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-map-motion,
        .hero-map-scale {
          transition: none;
        }
        .hero-map-dot {
          animation: none;
        }
        .reveal, .reveal-fade, .cinematic-reveal {
          transition: none;
          opacity: 1;
          transform: none;
          filter: none;
        }
        .ct-eyebrow, .ct-title, .ct-copy, .ct-cta {
          transition: none;
          opacity: 1;
          transform: none;
        }
        /* Suppresses the dive layer's body:has(#bestemming.is-visible)
           triggers entirely (not just their animation): a display:none
           ancestor removes its animated descendants from the render tree,
           so the fixedScan* keyframes above never run and the layer never
           becomes visible at any scroll position. */
        .hero-map-dive {
          display: none;
        }
      }
    </style>
  </head>
