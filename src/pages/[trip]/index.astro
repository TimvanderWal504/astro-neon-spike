    <!-- PAKLIJST — floating button + bottom-sheet checklist, ported from
         Main.dc.html:590-620. Renders unconditionally, independent of any
         chapter's lock state (AD-2). Items come from static
         `trip.data.packingList` (AD-7) — no fetch needed. Checked state is
         client-only, read/written via localStorage (AD-6, see script
         below); native <input type="checkbox"> gives real a11y semantics
         from the start (checked state, keyboard operability) instead of a
         div-based fake checkbox. -->
    <button
      type="button"
      id="packing-toggle"
      class="packing-toggle"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="packing-overlay"
    >
