    <!-- Fixed dive-layer instance + the REVEAL.md engine's overlay elements
         (prologue/telemetry/skip/debug) — direct children of <body>, NOT
         nested inside .hero. That nesting was the actual site of a real bug
         found via Playwright: .hero has `position:relative; z-index:3`,
         which makes it a stacking context — a position:fixed descendant's
         z-index is only compared WITHIN that context, not globally. Since
         .chapters also sits at z-index:3 and comes later in DOM order, it
         painted OVER this entire overlay regardless of the overlay's own
         z-index:50/60/etc, which is exactly what a screenshot caught
         (bestemming's own index number, since removed, visible through a
         supposedly-opaque, higher-z-index prologue). Moving these here, as
         true siblings of .hero/.chapters in the root stacking context, is
         the fix — confirmed by re-screenshotting after. -->
    <div class="hero-map-dive" aria-hidden="true">
      <svg class="hero-map-dive-svg" viewBox="80 0 790 790">
        <g class="hero-map-dive-zoom">
          <g class="hero-map-dive-grid">
            <line x1="80" y1="100" x2="870" y2="100" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="200" x2="870" y2="200" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="300" x2="870" y2="300" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="400" x2="870" y2="400" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="500" x2="870" y2="500" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="600" x2="870" y2="600" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="80" y1="700" x2="870" y2="700" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="100" y1="0" x2="100" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="200" y1="0" x2="200" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="300" y1="0" x2="300" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="400" y1="0" x2="400" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="500" y1="0" x2="500" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="600" y1="0" x2="600" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <line x1="700" y1="0" x2="700" y2="790" stroke={accentColor} stroke-width="0.6" opacity="0.16"/>
            <circle cx="455" cy="400" r="440" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
            <circle cx="455" cy="400" r="320" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
            <circle cx="455" cy="400" r="195" fill="none" stroke={accentColor} stroke-width="0.7" opacity="0.14"/>
          </g>
          <use id="reveal-lod0" href="#europe-coastline" />
          <!-- LOD1: the user's own hand-drawn Netherlands outline (see
               NL_TRACE_PATHS's comment in geodata-public.ts) — many small
               same-color fragments, because that's what a vtraced pen
               stroke actually is, not one outline path. Doesn't encode
               which Wadden island is the destination either way. -->
          <g id="reveal-lod1" transform={`translate(${NL_CENTER.x},${NL_CENTER.y}) scale(${NL_SCALE})`} fill={accentColor} fill-opacity="0.8" stroke="none">
            {NL_TRACE_PATHS.map((p) => (
              <path d={p.d} transform={`translate(${p.tx},${p.ty})`} />
            ))}
