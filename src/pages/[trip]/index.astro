---
import { getCollection } from 'astro:content';
import { sortByOrder } from '../../lib/trip-state';
// Safe to prerender — see the LOD1/2/3 comment further down where it's used.
import { NL_TRACE_WIDTH, NL_TRACE_PATHS } from '../../lib/reveal/geodata-public';

// LOD1 placement: NL_TRACE_PATHS is pre-centered around its own local
// (0,0) (see nl-trace.ts) — this just picks a target on-screen footprint
// and center to scale/translate it to. Width capped at 70 viewBox units
// (uniform scale, so height follows the source drawing's own proportions
// rather than being independently squashed); center reuses the same spot
// earlier calibration (screenshot-verified against the real coastline)
// found the real Netherlands sits at.
const NL_TARGET_WIDTH = 70;
const NL_SCALE = NL_TARGET_WIDTH / NL_TRACE_WIDTH;
const NL_CENTER = { x: 391, y: 410 };

// Static shell per AD-1: only structure (nav, hero, chapter slot order,
// ambient viewfinder) is prerendered. A chapter's real content never enters
// this template — only `id`/`order`/`kind` may drive markup here; real
// title/time/location/description/svgVariant arrive client-side only, via
// the fetch of the (redacted) GET /api/trip/[slug] response (AD-2).
export const prerender = true;

// Required because this dynamic route is prerendered (AD-1): Astro needs to
// know which [trip] paths exist at build time.
export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({
    params: { trip: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;

// Only trip-level styling/routing fields and per-chapter id/order/kind are
// read here — never a chapter's real content fields (see note above).
const accentColor = trip.data.accentColor;
const startDate = trip.data.startDate;
const slug = trip.data.slug;
const chapterSlots = sortByOrder(trip.data.chapters).map((chapter) => ({
  id: chapter.id,
  order: chapter.order,
  kind: chapter.kind,
}));
// Static, non-gated content (AD-2: the packing-list section is exempt from
// chapter-content-gating) — safe to read directly here, unlike chapter
// title/time/location/description above.
const packingList = trip.data.packingList;

// 8-digit hex-with-alpha strings (e.g. "#E3A64A24") for the ambient glow —
// computed here since CSS custom properties can't have hex digits appended
// to them in a stylesheet the way a template-string concatenation can.
const ambientGlowBackground = `radial-gradient(ellipse 70% 55% at 50% 10%, ${accentColor}24, transparent 62%), radial-gradient(ellipse 65% 55% at 88% 45%, ${accentColor}1a, transparent 60%), radial-gradient(ellipse 65% 55% at 8% 80%, ${accentColor}1a, transparent 60%)`;

// Same hex-with-alpha technique as ambientGlowBackground above, used for the
// #installeren step-number circle backgrounds (ported from Main.dc.html's
// rgba(227,166,74,0.15), rebuilt from the trip's own accentColor so a
// different trip's accent isn't stuck showing Main.dc.html's default).
const installStepIconBg = `${accentColor}26`;

// VAPID public key (story 8, AD-4): read server-side at prerender time and
// embedded via a data attribute for the client script's pushManager.subscribe
// call below — no PUBLIC_ rename needed, this build never ships to the
// client any other way.
const vapidPublicKey = import.meta.env.VAPID_PUBLIC_KEY ?? '';
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MoapMoap Vriendenweekend</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0d0c" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="MoapMoap" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <style define:vars={{ accent: accentColor }}>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: #0a0d0c;
        color: #f4f1ea;
        font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        position: relative;
        overflow-x: hidden;
      }
      .mono {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }

      /* AMBIENT GLOW — one continuous light source for the whole scroll.
         Background is set inline (see body markup) since it needs
         hex-with-alpha strings, not a plain CSS custom property value. */
      .ambient-glow {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        mix-blend-mode: screen;
      }

      /* HERO MAP — Europe scan-loop viewfinder (ported from
         design/ameland-weekend/Main.dc.html:276-324,184-189), now scoped to
         the hero's right-hand pane instead of a page-wide fixed watermark,
         so it reads as a real visual rather than ambient background texture.
         Only the ambient loop is built here; the Bestemming-triggered
         zoom/dive sequence is story 6 and is intentionally not ported. */
      .hero-map {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 3;
        transition: opacity 500ms ease;
      }
      /* Prevents the "double map" glitch: without this, the ambient map
         stays visible (it's mid-page, not scroll-cleared) while the fixed
         dive layer (z-index 50, see .hero-map-dive) fills the whole
         viewport on top of it the instant #bestemming comes into view. */
      body:has(#bestemming.is-visible) .hero-map {
        opacity: 0;
      }

      /* POST-REVEAL LAYOUT. Once bestemming is unlocked the page stops
         being a countdown that promises something and becomes the trip
         itself: the destination heads the page and the activities follow.
         Keyed off #bestemming.is-unlocked, which comes from the server's
         own chapter_unlocks state via /api/trip/[slug] — so every browser
         and every device agrees without needing any per-person memory.

         The hero goes rather than being trimmed: with the counter and its
         "de rest volgt hier" promise both stale, what's left is one button
         in a 100dvh box. The install instructions it pointed at are still
         on the page (#installeren), just below the chapters now. */
      body:has(#bestemming.is-unlocked) {
        display: flex;
        flex-direction: column;
      }
      body:has(#bestemming.is-unlocked) .hero {
        display: none;
      }
      body:has(#bestemming.is-unlocked) .chapters {
        order: 1;
        padding-top: 24px;
      }
      body:has(#bestemming.is-unlocked) #installeren {
        order: 2;
      }
      /* Ameland to the front of the chapter list. .chapters is already a
         flex column, so this is ordering only — the DOM, the data and the
         server response all keep their own order. */
      body:has(#bestemming.is-unlocked) #bestemming {
        order: -1;
      }
      .hero-map-svg {
        width: min(88vw, 560px);
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: visible;
        opacity: 0.3;
      }
      /* .hero-map-zoom (the wrapper group) never receives a transform of its
         own — the wander below animates its .hero-map-motion/.hero-map-scale
         children instead, each with their own transform-origin — so a
         transform-origin rule here has no visual effect. Removed rather than
         left at its old fixed viewBox percentage (39.620% 49.620% = absolute
         (393,392), Ameland's old anchor point): dead weight that happened to
         also be a leak, baked into every visitor's static, ungated CSS
         regardless of unlock state.
         Movement/scale are driven client-side (random walk, see script)
         rather than a fixed CSS keyframe loop, so the viewfinder wanders
         to a new point each cycle instead of repeating one fixed path. */
      .hero-map-motion {
        transition: transform 2.4s cubic-bezier(0.45, 0, 0.55, 1);
      }
      .hero-map-scale {
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 2.4s cubic-bezier(0.45, 0, 0.55, 1);
      }
      .hero-map-dot {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroViewfinderPulse 2600ms ease-in-out infinite;
      }
      .hero-map-flash {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
      }
      @keyframes heroViewfinderPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.25); }
      }

      /* HERO MAP — DIVE INSTANCE (story 6). Always-present, always
         position:fixed layer, invisible (opacity:0, pointer-events:none)
         until #bestemming becomes visible — then it fades in and plays the
         original fixedScanZoomSequence/fixedScanLockMove/fixedScanLockScale/
         fixedScanLockFlash keyframes (ported unchanged from
         Main.dc.html:165-229, targets renamed to this instance's classes).
         Reuses the ambient instance's coastline geometry via
         <use href="#europe-coastline">; never promotes .hero-map itself to
         position:fixed (would reflow .hero's flex layout). */
      .hero-map-dive {
        position: fixed;
        inset: 0;
        z-index: 50;
        opacity: 0;
        pointer-events: none;
        /* Solid background, not just the SVG floating over transparent —
         * REVEAL.md wants a real full-screen takeover, not a translucent
         * blend with whatever's behind (that was the old system's own
         * design, at a fixed 0.5 opacity; this sequence's own script now
         * owns opacity entirely, driving it to a full 1 once the prologue
         * hands off, so nothing bleeds through around/between the map's
         * own empty space). */
        background: #0a0d0c;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero-map-dive-svg {
        width: min(82vw, 640px);
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: visible;
      }
      .hero-map-dive-zoom {
        /* Overridden every frame by initReveal's camera engine
           (zoomG.style.transformOrigin = '0 0') the instant the dive starts
           — this static value is dead before it's ever seen, but still used
           to sit at the real destination's own coordinates (39.620% 49.620%
           = absolute (393,392)), baked into every visitor's public CSS
           regardless of unlock state. Set to match the runtime value instead
           of left stale. */
        transform-origin: 0 0;
      }
      .hero-map-dive-scale {
        transform-box: fill-box;
        transform-origin: center;
      }
      .hero-map-dive-flash {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
      }
      .hero-map-dive-dot {
        transform-box: fill-box;
        transform-origin: center;
        animation: heroViewfinderPulse 2600ms ease-in-out infinite;
      }
      .fixed-scan-caption {
        opacity: 0;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, 86px);
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--accent);
        white-space: nowrap;
      }

      /* REVEAL.md's camera engine (script below) writes .hero-map-dive-zoom's
         transform directly every frame via interpolateZoom — replaces the
         old fixed-duration fixedScan* CSS keyframes entirely, since the new
         camera path needs to be scroll-scrubbable and driven by real act
         boundaries, not a single fixed-length CSS animation. */
      .hero-map-dive-svg.is-impact { filter: invert(1); }
      .hero-map-dive-svg.is-mismatch { filter: sepia(1) saturate(6) hue-rotate(-40deg); }

      .reveal-prologue {
        position: fixed;
        inset: 0;
        z-index: 60;
        background: #050605;
        color: #f4f1ea;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        letter-spacing: 0.14em;
        text-align: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 400ms ease;
        padding: 24px;
      }
      .reveal-prologue.is-active {
        opacity: 1;
        pointer-events: auto;
      }
      .reveal-prologue-line1 {
        color: var(--accent);
        min-height: 1.4em;
      }
      .reveal-prologue-line2,
      .reveal-prologue-line3 {
        color: #9a9a91;
        min-height: 1.4em;
        font-size: 12px;
      }

      .reveal-telemetry {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 55;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
      }
      .reveal-telemetry.is-active {
        opacity: 0.75;
      }

      /* Search-phase candidate card: city, country, coordinate, and the
         reason it gets thrown out. Sits opposite the telemetry readout so
         the two never collide. */
      .reveal-stop {
        position: fixed;
        left: 20px;
        /* Clears .reveal-skip, which is pinned to the same corner at
           bottom:20px — they overlapped and the coordinate line was
           rendering straight through the Overslaan pill. */
        bottom: 84px;
        z-index: 55;
        max-width: min(72vw, 420px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 260ms ease;
      }
      .reveal-stop.is-active {
        opacity: 1;
      }
      .reveal-stop-name {
        font-size: clamp(28px, 7vw, 46px);
        line-height: 1.05;
        color: var(--accent);
        letter-spacing: -0.01em;
      }
      .reveal-stop-sub {
        margin-top: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        color: var(--accent);
        opacity: 0.65;
        font-variant-numeric: tabular-nums;
      }
      /* The rejection lands late in each stop, after the name has had a
         beat to register on its own. */
      .reveal-stop-reason {
        margin-top: 12px;
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(12px, 3.2vw, 14px);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #e5533d;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 200ms ease, transform 200ms ease;
      }
      .reveal-stop.is-rejected .reveal-stop-reason {
        opacity: 1;
        transform: none;
      }
      /* Struck through only once the reason is up, so the beat reads as
         "found it... no." */
      .reveal-stop.is-rejected .reveal-stop-name {
        text-decoration: line-through;
        text-decoration-thickness: 2px;
        opacity: 0.7;
      }

      .reveal-skip {
        position: fixed;
        left: 20px;
        bottom: 20px;
        z-index: 65;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        color: #f4f1ea;
        background: rgba(244, 241, 234, 0.08);
        border: 1px solid rgba(244, 241, 234, 0.2);
        border-radius: 999px;
        padding: 9px 16px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
        cursor: pointer;
      }
      .reveal-skip.is-active {
        opacity: 1;
        pointer-events: auto;
      }
      .reveal-skip:hover {
        background: rgba(244, 241, 234, 0.14);
      }

      .reveal-debug {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 90;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        line-height: 1.5;
        color: #7CFC00;
        background: rgba(0, 0, 0, 0.72);
        padding: 8px 10px;
        border-radius: 6px;
        white-space: pre;
        pointer-events: none;
        display: none;
      }
      .reveal-debug.is-active {
        display: block;
      }

      /* bestemming's epilogue text is gated on the new JS-driven
         .reveal-text-in class (added once the camera sequence's final act
         completes), not on .is-visible directly like the other three
         cinematic chapters — the camera/prologue sequence needs to finish
         first. Higher specificity (#bestemming beats the generic
         .cinematic-reveal class selector) holds it at opacity:0 despite
         .is-visible until that class is added. */
      #bestemming.is-visible .ct-eyebrow,
      #bestemming.is-visible .ct-title,
      #bestemming.is-visible .ct-copy,
      #bestemming.is-visible .ct-cta {
        opacity: 0;
      }
      #bestemming .chapter-content.reveal-text-in .ct-eyebrow {
        opacity: 1;
        transform: translateX(0);
        transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) 100ms, transform 700ms cubic-bezier(0.16, 1, 0.3, 1) 100ms;
      }
      #bestemming .chapter-content.reveal-text-in .ct-title {
        opacity: 1;
        transform: translateY(0) scale(1);
        transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1) 260ms, transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 260ms;
      }
      #bestemming .chapter-content.reveal-text-in .ct-copy {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1) 520ms, transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 520ms;
      }
      #bestemming .chapter-content.reveal-text-in .ct-cta {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) 680ms, transform 700ms cubic-bezier(0.16, 1, 0.3, 1) 680ms;
      }

      /* HERO */
      .hero {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 24px 64px;
        position: relative;
        z-index: 3;
        gap: 40px;
      }
      .hero-text {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      @media (min-width: 900px) {
        .hero {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          text-align: left;
          padding: 0 4vw;
          gap: 0;
        }
        .hero-text {
          align-items: flex-start;
          flex: 0 1 480px;
        }
        .hero-map {
          flex: 1 1 auto;
          align-self: stretch;
        }
        .hero-map-svg {
          height: min(84dvh, 920px);
          width: auto;
          aspect-ratio: 1 / 1;
          max-width: 100%;
          opacity: 0.4;
        }
      }
      .hero-days {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        line-height: 0.9;
        font-size: clamp(96px, 22vw, 220px);
        color: var(--accent);
        letter-spacing: -0.02em;
      }
      .hero-days-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #9a9a91;
        margin-top: 4px;
      }
      .hero-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-weight: 500;
        font-size: clamp(30px, 5.5vw, 48px);
        line-height: 1.18;
        letter-spacing: -0.005em;
        margin: 38px 0 14px;
        max-width: 15ch;
      }
      .hero-copy {
        font-size: 16px;
        line-height: 1.6;
        color: #c9c6bc;
        max-width: 38ch;
        margin-bottom: 32px;
        margin-bottom: 32px;
      }
      /* HERO CTA — ported from Main.dc.html:374, links down to #installeren. */
      .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 28px;
        border-radius: 999px;
        background: var(--accent);
        color: #0a0d0c;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
      }
      .hero-cta:hover {
        opacity: 0.8;
      }
      .hero-cta:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }

      /* REVEAL / CINEMATIC CHOREOGRAPHY — ported unchanged from
         Main.dc.html:37-108. `data-kind` on each .chapter-slot decides
         which reveal class server-side (cinematic -> cinematic-reveal,
         knap -> reveal); the shared IntersectionObserver (see script)
         adds .is-visible once per element. */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1), transform 700ms cubic-bezier(0.16,1,0.3,1);
      }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }
      .reveal-fade {
        opacity: 0;
        transition: opacity 900ms cubic-bezier(0.16,1,0.3,1);
      }
      .reveal-fade.is-visible { opacity: 1; }
      .cinematic-reveal {
        opacity: 0;
        transform: scale(1.06);
        filter: blur(14px);
        transition: opacity 1100ms cubic-bezier(0.16,1,0.3,1), transform 1300ms cubic-bezier(0.16,1,0.3,1), filter 1100ms cubic-bezier(0.16,1,0.3,1);
      }
      .cinematic-reveal.is-visible { opacity: 1; transform: scale(1); filter: blur(0); }
      /* bestemming's ct-eyebrow/title/copy/cta timing is now driven by the
         reveal engine's .reveal-text-in class (see the #bestemming-scoped
         rules further down), not a fixed transition-delay — the camera
         sequence's real length varies with scroll-scrub, so a fixed delay
         can no longer be correct. */

      /* staggered delay modifiers for individually-cascading elements (chips, timeline rows) */
      .reveal-d1 { transition-delay: 90ms; }
      .reveal-d2 { transition-delay: 180ms; }
      .reveal-d3 { transition-delay: 270ms; }
      .reveal-d4 { transition-delay: 360ms; }
      .reveal-d5 { transition-delay: 450ms; }

      /* cinematic text choreography - each piece moves on its own beat instead of one blob fade */
      .ct-eyebrow {
        opacity: 0;
        transform: translateX(-18px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1) 100ms, transform 700ms cubic-bezier(0.16,1,0.3,1) 100ms;
      }
      .cinematic-reveal.is-visible .ct-eyebrow { opacity: 1; transform: translateX(0); }
      .ct-title {
        opacity: 0;
        transform: translateY(34px) scale(0.98);
        transition: opacity 900ms cubic-bezier(0.16,1,0.3,1) 260ms, transform 900ms cubic-bezier(0.16,1,0.3,1) 260ms;
      }
      .cinematic-reveal.is-visible .ct-title { opacity: 1; transform: translateY(0) scale(1); }
      .ct-copy {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 800ms cubic-bezier(0.16,1,0.3,1) 520ms, transform 800ms cubic-bezier(0.16,1,0.3,1) 520ms;
      }
      .cinematic-reveal.is-visible .ct-copy { opacity: 1; transform: translateY(0); }
      .ct-cta {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 700ms cubic-bezier(0.16,1,0.3,1) 680ms, transform 700ms cubic-bezier(0.16,1,0.3,1) 680ms;
      }
      .cinematic-reveal.is-visible .ct-cta { opacity: 1; transform: translateY(0); }

      /* BLOKARTEN / BROUWERIJ ILLUSTRATIONS — ported from
         Main.dc.html:110-141,507-551 (hand-drawn SVG line art, never
         previously wired into this page — svgVariant was threaded through
         the data model but had no consumer, see deferred-work.md). Group
         coordinates are re-centered from the mockup's left-aligned original
         (translate(560,…)) to the viewBox's horizontal center
         (translate(400,…)) since this page's cinematic sections are
         center-aligned, not left-aligned like the mockup's. Shared
         stroke-draw-in keyframe (revealRouteDraw) also backs #bestemming's
         .reveal-route above. */
      @keyframes revealRouteDraw { to { stroke-dashoffset: 0; } }

      @keyframes revealRigIn { to { opacity: 0.7; transform: translateX(0); } }
      #blokarten .reveal-rig { opacity: 0; transform: translateX(-140px); }
      #blokarten.is-visible .reveal-rig { animation: revealRigIn 1300ms cubic-bezier(0.16,1,0.3,1) 200ms forwards; }
      #blokarten .reveal-mast, #blokarten .reveal-sail { stroke-dasharray: 280; stroke-dashoffset: 280; }
      #blokarten.is-visible .reveal-mast, #blokarten.is-visible .reveal-sail { animation: revealRouteDraw 800ms cubic-bezier(0.16,1,0.3,1) 700ms forwards; }
      @keyframes revealWheelIn { to { opacity: 1; transform: scale(1); } }
      #blokarten .reveal-wheel { opacity: 0; transform: scale(0); transform-box: fill-box; transform-origin: center; }
      #blokarten.is-visible .reveal-wheel-1 { animation: revealWheelIn 480ms cubic-bezier(0.34,1.56,0.64,1) 1020ms forwards; }
      #blokarten.is-visible .reveal-wheel-2 { animation: revealWheelIn 480ms cubic-bezier(0.34,1.56,0.64,1) 1090ms forwards; }
      #blokarten.is-visible .reveal-wheel-3 { animation: revealWheelIn 480ms cubic-bezier(0.34,1.56,0.64,1) 1160ms forwards; }
      #blokarten .reveal-track { stroke-dasharray: 1000; stroke-dashoffset: 1000; }
      #blokarten.is-visible .reveal-track { animation: revealRouteDraw 1500ms cubic-bezier(0.16,1,0.3,1) 100ms forwards; }
      /* Beach-vibe pass: kicked-up sand behind the wheels, reusing the
         same dashoffset draw-in as the ambient route/horizon lines. */
      #blokarten .reveal-wake { stroke-dasharray: 220; stroke-dashoffset: 220; opacity: 0.8; }
      #blokarten.is-visible .reveal-wake-1 { animation: revealRouteDraw 450ms cubic-bezier(0.16,1,0.3,1) 1350ms forwards; }
      #blokarten.is-visible .reveal-wake-2 { animation: revealRouteDraw 450ms cubic-bezier(0.16,1,0.3,1) 1410ms forwards; }
      #blokarten.is-visible .reveal-wake-3 { animation: revealRouteDraw 450ms cubic-bezier(0.16,1,0.3,1) 1470ms forwards; }
      #blokarten.is-visible .reveal-wake-4 { animation: revealRouteDraw 450ms cubic-bezier(0.16,1,0.3,1) 1530ms forwards; }
      #blokarten.is-visible .reveal-wake-5 { animation: revealRouteDraw 450ms cubic-bezier(0.16,1,0.3,1) 1590ms forwards; }
      /* Soft dust mass behind the wake fan — the streaks alone read thin;
         a low-opacity blob gives the kicked-up sand some weight. */
      #blokarten .reveal-dust { opacity: 0; }
      @keyframes revealDustIn { to { opacity: 0.12; } }
      #blokarten.is-visible .reveal-dust { animation: revealDustIn 900ms cubic-bezier(0.16,1,0.3,1) 1300ms forwards; }
      /* Wind-rush lines swept back off the sail's leading edge, inside the
         same rotated sail group so they always lean with it. */
      #blokarten .reveal-wind { stroke-dasharray: 60; stroke-dashoffset: 60; }
      #blokarten.is-visible .reveal-wind-1 { animation: revealRouteDraw 400ms cubic-bezier(0.16,1,0.3,1) 1550ms forwards; }
      #blokarten.is-visible .reveal-wind-2 { animation: revealRouteDraw 400ms cubic-bezier(0.16,1,0.3,1) 1620ms forwards; }
      #blokarten.is-visible .reveal-wind-3 { animation: revealRouteDraw 400ms cubic-bezier(0.16,1,0.3,1) 1690ms forwards; }
      /* Two distant gulls; shared entrance keyframe (only the delay
         differs per instance), same birdFlap loop Zondag's bird uses. */
      #blokarten .reveal-bird { opacity: 0; transform: translateY(10px); transform-box: fill-box; transform-origin: center; }
      @keyframes revealGullIn { to { opacity: 0.45; transform: translateY(0); } }
      #blokarten.is-visible .reveal-bird-1 { animation: revealGullIn 1200ms cubic-bezier(0.16,1,0.3,1) 250ms forwards; }
      #blokarten.is-visible .reveal-bird-2 { animation: revealGullIn 1200ms cubic-bezier(0.16,1,0.3,1) 420ms forwards; }
      #blokarten .reveal-bird-flap { transform-box: fill-box; transform-origin: center; animation: birdFlap 480ms ease-in-out infinite; }

      /* Two mugs swing in from opposite sides and meet in the middle. */
      @keyframes revealMugLeftIn { to { opacity: 0.7; transform: rotate(14deg) translateX(0); } }
      @keyframes revealMugRightIn { to { opacity: 0.7; transform: rotate(-14deg) translateX(0); } }
      #brouwerij .reveal-mug-left { opacity: 0; transform: rotate(14deg) translateX(-30px); transform-box: fill-box; transform-origin: center; }
      #brouwerij .reveal-mug-right { opacity: 0; transform: rotate(-14deg) translateX(30px); transform-box: fill-box; transform-origin: center; }
      #brouwerij.is-visible .reveal-mug-left { animation: revealMugLeftIn 700ms cubic-bezier(0.34,1.2,0.64,1) 200ms forwards; }
      #brouwerij.is-visible .reveal-mug-right { animation: revealMugRightIn 700ms cubic-bezier(0.34,1.2,0.64,1) 200ms forwards; }
      /* Clink spark, right as the mugs meet. */
      @keyframes revealClinkIn { 0% { opacity: 0; transform: scale(0.4); } 60% { opacity: 1; transform: scale(1.15); } 100% { opacity: 0.8; transform: scale(1); } }
      #brouwerij .reveal-clink { opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center; }
      #brouwerij.is-visible .reveal-clink { animation: revealClinkIn 600ms cubic-bezier(0.16,1,0.3,1) 850ms forwards; }
      @keyframes revealBubble1In { to { opacity: 0.6; transform: translateY(0); } }
      @keyframes revealBubble2In { to { opacity: 0.5; transform: translateY(0); } }
      @keyframes revealBubble3In { to { opacity: 0.4; transform: translateY(0); } }
      #brouwerij .reveal-bubble { opacity: 0; transform: translateY(10px); transform-box: fill-box; }
      #brouwerij.is-visible .reveal-bubble-1 { animation: revealBubble1In 700ms cubic-bezier(0.16,1,0.3,1) 1100ms forwards; }
      #brouwerij.is-visible .reveal-bubble-2 { animation: revealBubble2In 700ms cubic-bezier(0.16,1,0.3,1) 1220ms forwards; }
      #brouwerij.is-visible .reveal-bubble-3 { animation: revealBubble3In 700ms cubic-bezier(0.16,1,0.3,1) 1340ms forwards; }

      /* DUINEXCURSIE ILLUSTRATION — a walked route, not a static object like
         Blokarten's rig or Brouwerij's kettle: a footpath traces across the
         dune, a soft second ridge sits behind the main one for depth, the
         helmgras keeps swaying in the wind after it grows in, and the bird
         actually flaps instead of just gliding. The one-shot entrances
         (fade/scale/translate) live on the outer reveal-* groups exactly
         like Blokarten/Brouwerij above; the two ambient loops (grass sway,
         wingbeat) live on nested inner groups with their own `infinite`
         animation, same idiom as .hero-viewfinder's heroViewfinderPulse —
         two elements, two independent transforms, no conflict. */
      @keyframes revealDuneBackIn { to { opacity: 1; } }
      #zondag .reveal-dune-back { opacity: 0; }
      #zondag.is-visible .reveal-dune-back { animation: revealDuneBackIn 900ms cubic-bezier(0.16,1,0.3,1) 100ms forwards; }
      @keyframes revealDuneIn { to { opacity: 0.6; transform: scale(1); } }
      #zondag .reveal-dune { opacity: 0; transform: scale(0.94); transform-box: fill-box; transform-origin: center; }
      #zondag.is-visible .reveal-dune { animation: revealDuneIn 1000ms cubic-bezier(0.16,1,0.3,1) 200ms forwards; }
      @keyframes revealTrailIn { to { opacity: 0.35; transform: scaleX(1); } }
      #zondag .reveal-trail { opacity: 0; transform: scaleX(0); transform-box: fill-box; transform-origin: left; stroke-dasharray: 3 11; }
      #zondag.is-visible .reveal-trail { animation: revealTrailIn 1400ms cubic-bezier(0.16,1,0.3,1) 550ms forwards; }
      @keyframes revealGrassIn { to { opacity: 0.55; transform: scaleY(1); } }
      #zondag .reveal-grass { opacity: 0; transform: scaleY(0); transform-box: fill-box; transform-origin: bottom; }
      #zondag.is-visible .reveal-grass-1 { animation: revealGrassIn 480ms cubic-bezier(0.34,1.56,0.64,1) 900ms forwards; }
      #zondag.is-visible .reveal-grass-2 { animation: revealGrassIn 480ms cubic-bezier(0.34,1.56,0.64,1) 980ms forwards; }
      #zondag.is-visible .reveal-grass-3 { animation: revealGrassIn 480ms cubic-bezier(0.34,1.56,0.64,1) 1060ms forwards; }
      @keyframes grassSway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }
      #zondag .reveal-grass-sway { transform-box: fill-box; transform-origin: bottom; animation: grassSway 3400ms ease-in-out infinite; }
      #zondag .reveal-grass-1 .reveal-grass-sway { animation-delay: -400ms; }
      #zondag .reveal-grass-2 .reveal-grass-sway { animation-delay: -1600ms; }
      #zondag .reveal-grass-3 .reveal-grass-sway { animation-delay: -2600ms; }
      @keyframes revealRabbitIn { to { opacity: 0.45; transform: scale(1); } }
      #zondag .reveal-rabbit { opacity: 0; transform: scale(0.7); transform-box: fill-box; transform-origin: center; }
      #zondag.is-visible .reveal-rabbit { animation: revealRabbitIn 700ms cubic-bezier(0.16,1,0.3,1) 1300ms forwards; }
      @keyframes revealBirdIn { to { opacity: 0.5; transform: translate(220px, -10px) rotate(2deg); } }
      #zondag .reveal-bird { opacity: 0; transform: translate(-80px, 6px) rotate(-4deg); transform-box: fill-box; transform-origin: center; }
      #zondag.is-visible .reveal-bird { animation: revealBirdIn 1900ms cubic-bezier(0.16,1,0.3,1) 300ms forwards; }
      @keyframes birdFlap { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.55); } }
      #zondag .reveal-bird-flap { transform-box: fill-box; transform-origin: center; animation: birdFlap 480ms ease-in-out infinite; }

      /* INSTALLEREN — ported from Main.dc.html:402-442. The toggle's
         sc-if/setState mechanism doesn't exist in this plain-script page:
         a `data-platform` attribute on #installeren (set by the click
         handlers in the script block) drives which button/steps block is
         shown via the attribute-selector pairs below, instead of adding or
         removing classes on each element individually. Renders statically
         at full opacity, deliberately with no .reveal/.cinematic-reveal
         class (story 1.6 scoped that system to chapter slots only). */
      .installeren {
        position: relative;
        z-index: 3;
        width: 100%;
        padding: 0px 24px 96px;
        max-width: 640px;
        margin: 0 auto;
      }
      .installeren-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: clamp(26px, 4vw, 34px);
        font-weight: 600;
        margin: 0 0 10px;
      }
      .installeren-copy {
        color: #c9c6bc;
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 28px;
        max-width: 44ch;
      }
      .installeren-buttons {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
      }
      .installeren-btn {
        flex: 1;
        padding: 11px;
        border-radius: 10px;
        border: 1px solid rgba(244, 241, 234, 0.18);
        background: transparent;
        color: #f4f1ea;
        font-weight: 600;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
      }
      #installeren[data-platform='android'] .installeren-btn[data-platform-btn='android'],
      #installeren[data-platform='ios'] .installeren-btn[data-platform-btn='ios'] {
        border-color: var(--accent);
        background: var(--accent);
        color: #0a0d0c;
      }
      .installeren-btn:hover {
        opacity: 0.8;
      }
      .installeren-btn:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .installeren-steps {
        display: none;
        flex-direction: column;
        gap: 16px;
        border: 1px solid rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 22px;
      }
      #installeren[data-platform='android'] .installeren-steps[data-platform-steps='android'],
      #installeren[data-platform='ios'] .installeren-steps[data-platform-steps='ios'] {
        display: flex;
      }
      .installeren-step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }
      .installeren-step-num {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border-radius: 999px;
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
      }
      .installeren-step p {
        margin: 0;
        font-size: 14px;
        line-height: 1.55;
        color: #e5e2d9;
      }

      /* MELDINGEN AANZETTEN (story 8, AD-4) — minimal, on-brand control
         next to #installeren; no mockup exists for this, styled to match
         .installeren-btn/.installeren-copy rather than invent a new visual
         language. */
      .notify-block {
        margin-top: 24px;
      }
      .notify-toggle {
        display: block;
        width: 100%;
        padding: 13px;
        border-radius: 10px;
        border: 1px solid rgba(244, 241, 234, 0.18);
        background: transparent;
        color: #f4f1ea;
        font-weight: 600;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
      }
      .notify-toggle:hover {
        opacity: 0.8;
      }
      .notify-toggle:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .notify-message {
        margin: 12px 0 0;
        font-size: 13px;
        line-height: 1.5;
        color: #c9c6bc;
      }

      /* CHAPTER SLOTS */
      .chapters {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: 24px;
        /* width:100% is load-bearing once body becomes flex (post-reveal
           layout below): a flex item with auto cross-axis margins and no
           explicit width sizes to shrink-to-fit instead of filling the
           line, so max-width:640px + margin:0 auto collapsed this to its
           narrowest content width instead of centering a 640px column. */
        width: 100%;
        padding: 0 24px 96px;
        max-width: 640px;
        margin: 0 auto;
      }
      .chapter-slot {
        display: none;
      }
      .chapter-slot.is-unlocked {
        display: block;
      }
      /* KNAP — compact logistics card (time/location). Not a sell
         moment, stays a modest card in the 640px column. */
      .chapter-slot[data-kind='knap'] {
        border: 1px dashed rgba(244, 241, 234, 0.1);
        border-radius: 16px;
        padding: 28px;
      }
      /* CINEMATIC — full-bleed sell moment (destination/activity
         reveals). Breaks out of .chapters' 640px column via the
         standard calc(50% - 50vw) containing-block trick, since the
         percentage always resolves against .chapters' own (centered)
         content width regardless of viewport size. */
      .chapter-slot[data-kind='cinematic'] {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        min-height: 100dvh;
        padding: 64px 24px;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        text-align: center;
        overflow: hidden;
      }
      .chapter-slot[data-kind='cinematic'].is-unlocked {
        display: flex;
      }
      .chapter-slot[data-kind='cinematic'] .chapter-content {
        max-width: 640px;
      }
      /* Illustration gets its own dedicated band (fixed height, full width)
         instead of sitting full-bleed behind the text — the two used to
         occupy the same space (text z-index:1 over illustration z-index:0),
         which read as content "hovering over" the artwork rather than
         living beside it. `meet` (not `slice`) guarantees the whole
         hand-drawn scene stays visible within that band regardless of
         viewport aspect, rather than being cropped to fill it. */
      .chapter-visual {
        position: relative;
        width: 100%;
        max-width: 900px;
        height: min(42vh, 380px);
        flex: 0 0 auto;
      }
      .chapter-illustration {
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
      }
      .chapter-title {
        font-family: 'Bodoni Moda', Georgia, serif;
        font-size: 22px;
        margin: 8px 0 6px;
      }
      /* Cinematic titles get hero-level confidence instead of the
         knap card's modest 22px — this is the sell moment. */
      .chapter-slot[data-kind='cinematic'] .chapter-title {
        font-size: clamp(52px, 13vw, 140px);
        line-height: 0.96;
        max-width: 14ch;
        margin: 20px auto 18px;
      }
      .chapter-meta {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: #9a9a91;
        margin: 0 0 10px;
      }
      .chapter-slot[data-kind='cinematic'] .chapter-meta {
        font-size: 13px;
        letter-spacing: 0.22em;
      }
      .chapter-description {
        font-size: 15px;
        line-height: 1.6;
        color: #e5e2d9;
        white-space: pre-line;
      }
      .chapter-slot[data-kind='cinematic'] .chapter-description {
        font-size: clamp(16px, 2vw, 19px);
        max-width: 44ch;
        margin-left: auto;
        margin-right: auto;
      }
      .chapter-replay {
        display: inline-block;
        margin-top: 14px;
        padding: 0;
        border: none;
        background: none;
        font-family: 'JetBrains Mono', monospace;
        font-variant: small-caps;
        font-size: 12px;
        letter-spacing: 0.14em;
        color: #9a9a91;
        cursor: pointer;
      }
      .chapter-replay:hover {
        color: var(--accent);
      }
      .chapter-replay:focus-visible {
        color: var(--accent);
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }

      /* PAKLIJST — floating button + bottom-sheet overlay, ported from
         Main.dc.html:590-620 (mockup's sc-if/setState pseudo-framework ->
         plain DOM class/hidden toggling, story 7's approach). Renders
         unconditionally, independent of chapter lock state (AD-2). z-index
         must clear .hero-map-dive's z-index:50 (story 6) — the mockup's own
         50/60 values collide with it, so these go higher. */
      .packing-toggle {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 65;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 20px;
        border-radius: 999px;
        border: none;
        background: #f4f1ea;
        color: #0a0d0c;
        font-weight: 600;
        font-size: 14px;
        font-family: inherit;
        cursor: pointer;
        box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.6);
      }
      .packing-toggle:hover {
        opacity: 0.85;
      }
      .packing-toggle:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-overlay {
        position: fixed;
        inset: 0;
        z-index: 75;
        background: rgba(5, 6, 6, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }
      .packing-overlay[hidden] {
        display: none;
      }
      .packing-sheet {
        width: 100%;
        max-width: 480px;
        max-height: 76dvh;
        overflow-y: auto;
        background: #12160f;
        border-radius: 24px 24px 0 0;
        border: 1px solid rgba(244, 241, 234, 0.1);
        padding: 28px 24px 32px;
      }
      .packing-sheet-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
      }
      .packing-sheet-title {
        margin: 0;
        font-size: 19px;
        font-weight: 600;
      }
      .packing-close {
        background: none;
        border: none;
        color: #9a9a91;
        cursor: pointer;
        padding: 4px;
      }
      .packing-close:hover {
        color: #f4f1ea;
      }
      .packing-close:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-sheet-copy {
        color: #9a9a91;
        font-size: 13px;
        margin: 0 0 20px;
      }
      .packing-category {
        margin: 0 0 4px;
      }
      .packing-category-title {
        margin: 20px 0 2px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #9a9a91;
      }
      .packing-sheet-copy + .packing-category .packing-category-title {
        margin-top: 0;
      }
      .packing-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .packing-item {
        border-bottom: 1px solid rgba(244, 241, 234, 0.08);
      }
      .packing-item:last-child {
        border-bottom: none;
      }
      .packing-item-label {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 2px;
        cursor: pointer;
      }
      .packing-checkbox {
        appearance: none;
        -webkit-appearance: none;
        flex: 0 0 auto;
        width: 22px;
        height: 22px;
        margin: 0;
        border-radius: 6px;
        border: 1px solid rgba(244, 241, 234, 0.3);
        background: transparent;
        position: relative;
        cursor: pointer;
      }
      .packing-checkbox:checked {
        background: var(--accent);
        border-color: var(--accent);
      }
      .packing-checkbox:checked::after {
        content: '';
        position: absolute;
        left: 7px;
        top: 3px;
        width: 5px;
        height: 10px;
        border: solid #0a0d0c;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
      }
      .packing-checkbox:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }
      .packing-item-text {
        font-size: 14px;
        color: #e5e2d9;
      }
      .packing-item-label:has(.packing-checkbox:checked) .packing-item-text {
        color: #7d7c74;
        text-decoration: line-through;
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-map-motion,
        .hero-map-scale {
          transition: none;
        }
        .hero-map-dot {
          animation: none;
        }
        .reveal, .reveal-fade, .cinematic-reveal {
          transition: none;
          opacity: 1;
          transform: none;
          filter: none;
        }
        .ct-eyebrow, .ct-title, .ct-copy, .ct-cta {
          transition: none;
          opacity: 1;
          transform: none;
        }
        /* The reveal engine (script) also checks prefers-reduced-motion
           itself and skips straight to the epilogue text without ever
           starting the camera loop or showing the prologue — this is
           belt-and-suspenders in case JS is slow to init on first paint. */
        .hero-map-dive,
        .reveal-prologue,
        .reveal-telemetry,
        .reveal-stop,
        .reveal-skip {
          display: none;
        }
        /* Blokarten/brouwerij illustrations settle at their end-state
           instead of animating in (ported from Main.dc.html:238-248). */
        #blokarten.is-visible .reveal-rig, #blokarten .reveal-rig { animation: none; opacity: 0.7; transform: none; }
