    <button type="button" class="reveal-skip" data-reveal-skip>Overslaan</button>
    <div class="reveal-debug" data-reveal-debug aria-hidden="true"></div>

    <!-- INSTALLEREN — ported from Main.dc.html:402-442. No .reveal class:
         renders statically at full opacity (story 1.6 scoped the reveal
         system to chapter slots only). data-platform defaults to
         'android', matching Main.dc.html's initial state.platform. -->
    <section id="installeren" class="installeren" data-platform="android">
      <h2 class="installeren-title">Zet 'm op je scherm</h2>
      <p class="installeren-copy">
        Zo krijg je meldingen zodra er iets bekend wordt. Kies je toestel.
      </p>

      <div class="installeren-buttons">
        <button type="button" class="installeren-btn" data-platform-btn="android" aria-pressed="true">Android</button>
        <button type="button" class="installeren-btn" data-platform-btn="ios" aria-pressed="false">iPhone</button>
      </div>

      <div class="installeren-steps" data-platform-steps="android">
        <div class="installeren-step">
          <div class="installeren-step-num mono" style={`background:${installStepIconBg}`}>1</div>
          <p>Chrome laat vanzelf een balkje zien: <strong>"App installeren"</strong>. Tik daarop.</p>
        </div>
        <div class="installeren-step">
          <div class="installeren-step-num mono" style={`background:${installStepIconBg}`}>2</div>
          <p>Klaar. Het icoon staat op je startscherm en meldingen werken direct.</p>
        </div>
      </div>
      <div class="installeren-steps" data-platform-steps="ios">
        <div class="installeren-step">
          <div class="installeren-step-num" style={`background:${installStepIconBg}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M8 8l4-4 4 4"/><path d="M4 14v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/></svg>
          </div>
          <p>Tik onderin Safari op het deel-icoon (het vierkantje met het pijltje omhoog).</p>
        </div>
        <div class="installeren-step">
          <div class="installeren-step-num mono" style={`background:${installStepIconBg}`}>2</div>
          <p>Kies <strong>"Zet op beginscherm"</strong>. Zonder deze stap werken meldingen op iPhone niet.</p>
        </div>
      </div>

      <!-- MELDINGEN AANZETTEN — story 8, AD-4. Permission-denied,
           already-subscribed, and subscribe-failure states are all shown
           explicitly via #notify-message (see script), never a silent
           no-op or a repeated browser prompt. -->
      <div class="notify-block" id="notify-controls" data-vapid-key={vapidPublicKey}>
        <button type="button" id="notify-subscribe-button" class="notify-toggle">
          Meldingen aanzetten
        </button>
        <p id="notify-message" class="notify-message" role="status" hidden></p>
      </div>
    </section>

    <!-- CHAPTER SLOTS — only id/order/kind drive this markup. Each slot
         stays display:none (see .chapter-slot) until client-side JS adds
         .is-unlocked, so a locked chapter has no visible trace at all —
         real content (title/time/location/description) is filled in only
         once the fetch of /api/trip/[slug] reports it unlocked, never
         embedded here. -->
    <div class="chapters">
      {
        chapterSlots.map((chapter) => {
          const isCinematic = chapter.kind === 'cinematic';
          return (
            <section
              class={`chapter-slot ${isCinematic ? 'cinematic-reveal' : 'reveal'}`}
              id={chapter.id}
              data-order={chapter.order}
              data-kind={chapter.kind}
            >
              {chapter.id === 'blokarten' && (
                // Hand-drawn land-sailing rig, redrawn from Main.dc.html:507-517.
                // The mockup's own numbers (mast to y=-190, ~255 units tall,
                // centered dead-behind the text) read fine in its left-aligned
                // layout but turned into an oversized, unreadable blob once
                // centered behind this page's huge centered title — shrunk
                // here (~0.6x) and grounded lower in the frame (y 440→580) so
                // it sits as a supporting mark beneath the text, not behind it.
                // Now lives in its own .chapter-visual band (dedicated,
                // non-overlapping space below the text) — viewBox tightened
                // to the actual content area and preserveAspectRatio switched
                // to "meet" so nothing gets cropped inside that shorter box.
                // Beach-vibe pass: horizon line (5th reveal-track), sand wake
                // behind the wheels, and two gulls give it ground + motion +
                // air, which the bare rig had none of. Only the mast+sail
                // sub-group rotates (rigged around its own base at 0,6) to
                // rake back under wind load — the frame/wheels stay level,
                // since rotating the whole chassis put the wide-set wheels
                // at different ground heights and read as tipping over.
                <div class="chapter-visual">
                  <svg class="chapter-illustration" viewBox="-40 140 880 580" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                    <path class="reveal-track" d="M-40,180 C160,150 300,210 800,170" stroke={accentColor} stroke-width="1" opacity="0.16" fill="none" />
                    <path class="reveal-track" d="M-40,230 C160,200 320,255 800,220" stroke={accentColor} stroke-width="1" opacity="0.12" fill="none" />
                    <path class="reveal-track" d="M-40,606 C160,596 300,614 460,604 C580,596 700,612 800,602" stroke={accentColor} stroke-width="1.4" opacity="0.22" fill="none" />
                    <path class="reveal-track" d="M-40,650 C160,630 320,668 500,645 C620,630 720,650 800,640" stroke={accentColor} stroke-width="1" opacity="0.16" fill="none" />
                    <path class="reveal-track" d="M-40,690 C160,670 320,708 500,685 C620,670 720,690 800,680" stroke={accentColor} stroke-width="1" opacity="0.1" fill="none" />
                    <g transform="translate(250,220)">
                      <g class="reveal-bird reveal-bird-1">
