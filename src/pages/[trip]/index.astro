      Paklijst
    </button>

    <div id="packing-overlay" class="packing-overlay" hidden>
      <div class="packing-sheet" role="dialog" aria-modal="true" aria-labelledby="packing-title">
        <div class="packing-sheet-header">
          <h3 id="packing-title" class="packing-sheet-title">Paklijst</h3>
          <button type="button" id="packing-close" class="packing-close" aria-label="Sluiten">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <p class="packing-sheet-copy">Handige zaken om mee te nemen. Staat vast vanaf dag &eacute;&eacute;n, ook al is nog niet alles bekend.</p>

        {
          packingList.map((category) => (
            <div class="packing-category" role="group" aria-labelledby={`packing-category-${category.id}`}>
              <h4 id={`packing-category-${category.id}`} class="packing-category-title">{category.label}</h4>
              <ul class="packing-list">
                {
                  category.items.map((item) => (
                    <li class="packing-item">
                      <label class="packing-item-label">
                        <input type="checkbox" class="packing-checkbox" data-packing-id={item.id} />
                        <span class="packing-item-text">{item.label}</span>
                      </label>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <script>
      // REVEAL.md's camera math and timeline — both destination-agnostic,
      // safe for this always-shipped client bundle (see
      // src/lib/reveal/geodata-secret.ts's header for what is NOT safe to
      // import here, and why).
      import { interpolateZoom } from '../../lib/interpolate-zoom';
      import { getActState, pushScrubOffset, stepScrubSpring } from '../../lib/reveal/timeline';
      import { DECOY_STOPS } from '../../lib/reveal/geodata-public';
      import type { ZoomPoint } from '../../lib/interpolate-zoom';

      // daysLeft is always computed fresh, client-side, from the static
      // `data-start` attribute — never baked in once at build time, so a
      // static build never goes stale (mirrors Main.dc.html's formula).
      const body = document.body;
      const startISO = body.dataset.start;
      const tripSlug = body.dataset.tripSlug;

      // Set once #bestemming's reveal observer fires (see IntersectionObserver
      // setup below) — stops startViewfinderWander's recursive step() so an
      // un-stopped tick can't resume overwriting the ambient map's inline
      // transform style after the dive sequence's CSS animation ends.
      let wanderStopped = false;

      function computeDaysLeft(): number {
        const target = new Date(startISO ?? '');
        const now = new Date();
        return Math.max(0, Math.ceil((target.getTime() - now.getTime()) / 86400000));
      }

      function renderDaysLeft(): void {
        const daysLeft = String(computeDaysLeft());
        document.querySelectorAll('[data-days-left]').forEach((el) => {
          el.textContent = daysLeft;
        });
      }

      renderDaysLeft();

      // Viewfinder wander: a random walk over the landmass area of the real
      // Europe vector map (roughly Western/Central Europe) instead of a
      // fixed CSS keyframe loop, so the motion never repeats the same path
      // twice. Skipped entirely under prefers-reduced-motion, settling on a
      // neutral wide-Europe point instead — the SAME (475,395) point
      // geodata-secret.ts's CAMERA_KEYPOINTS.wide already uses to open the
      // search sequence, not anything correlated with the real destination.
      // This used to be the real destination's own coordinates (393,392),
      // hardcoded here as both the reduced-motion position AND the wander's
      // very first frame before randomization — shipped in the public JS
      // bundle every visitor downloads, regardless of unlock state.
      function startViewfinderWander(): void {
        const motionEl = document.querySelector<SVGGElement>('.hero-map-motion');
        const scaleEl = document.querySelector<SVGGElement>('.hero-map-scale');
        if (!motionEl || !scaleEl) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          motionEl.style.transform = 'translate(475px, 395px)';
          scaleEl.style.transform = 'scale(1.08)';
          return;
        }

        const X_MIN = 238;
        const X_MAX = 688;
        const Y_MIN = 230;
        const Y_MAX = 632;
        const SCALE_MIN = 0.9;
        const SCALE_MAX = 1.25;
        const MOVE_MS_MIN = 2200;
        const MOVE_MS_MAX = 4200;
        const PAUSE_MS_MIN = 300;
        const PAUSE_MS_MAX = 900;

        const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);

        function step(): void {
          if (wanderStopped) return;

          const x = randomBetween(X_MIN, X_MAX);
          const y = randomBetween(Y_MIN, Y_MAX);
          const scale = randomBetween(SCALE_MIN, SCALE_MAX);
          const durationMs = randomBetween(MOVE_MS_MIN, MOVE_MS_MAX);

          motionEl!.style.transitionDuration = `${durationMs}ms`;
          scaleEl!.style.transitionDuration = `${durationMs}ms`;
          motionEl!.style.transform = `translate(${x}px, ${y}px)`;
          scaleEl!.style.transform = `scale(${scale})`;

          setTimeout(step, durationMs + randomBetween(PAUSE_MS_MIN, PAUSE_MS_MAX));
        }

        // First placement jumps in instantly (no transition) so it doesn't
        // glide in from the SVG origin on page load.
        motionEl.style.transitionDuration = '0s';
        scaleEl.style.transitionDuration = '0s';
        motionEl.style.transform = 'translate(475px, 395px)';
        scaleEl.style.transform = 'scale(1.08)';
        requestAnimationFrame(step);
      }

      startViewfinderWander();

      // Reveal / cinematic choreography (ported unchanged from
      // Main.dc.html's componentDidMount): the observer is created and
      // observes every .reveal/.reveal-fade/.cinematic-reveal element
      // synchronously here, independent of loadTripState()'s async fetch — a
      // locked chapter's slot already carries its reveal class server-side
      // (see chapter-slot markup above), it's just display:none until
      // unlocked, so it's observed from the start.
      const revealTargets = document.querySelectorAll('.reveal, .reveal-fade, .cinematic-reveal');
      const prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (typeof IntersectionObserver === 'undefined' || prefersReducedMotion) {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
        wanderStopped = true;
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
                if (entry.target.id === 'bestemming') {
                  wanderStopped = true;
                }
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
        );
        revealTargets.forEach((el) => revealObserver.observe(el));
      }

      // Replay ("Bekijk opnieuw"): remove then re-add .is-visible on the
      // chapter's own reveal/cinematic-reveal element so its CSS
      // transitions retrigger from the start. Bestemming no longer renders
      // this button (see its markup), so only the activity chapters and
      // their own illustrations come through here.
      document.querySelectorAll<HTMLButtonElement>('[data-replay-target]').forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.dataset.replayTarget;
          const target = targetId ? document.getElementById(targetId) : null;
          if (!target) return;
          target.classList.remove('is-visible');
          void target.offsetWidth;
          requestAnimationFrame(() => target.classList.add('is-visible'));
        });
      });

      // Merge real content into unlocked chapter slots via the redacted
      // trip-state API (AD-2). Locked chapters are never touched — they
      // stay display:none (see .chapter-slot), invisible until unlocked.
      async function loadTripState(): Promise<void> {
        if (!tripSlug) return;
        try {
          const res = await fetch(`/api/trip/${encodeURIComponent(tripSlug)}`);
          const payload = await res.json();
          if (!payload.ok) return;

          const chapters = payload.data?.chapters ?? [];
          for (const chapter of chapters) {
            if (!chapter.unlocked) continue;
            const slot = document.getElementById(chapter.id);
            if (!slot) continue;

            slot.classList.add('is-unlocked');
            const titleEl = slot.querySelector('[data-field="title"]');
            if (titleEl) titleEl.textContent = chapter.title;
            const timeEl = slot.querySelector('[data-field="time"]');
            if (timeEl) timeEl.textContent = chapter.time ?? '';
            const locationEl = slot.querySelector('[data-field="location"]');
            if (locationEl) locationEl.textContent = chapter.location ?? '';
            const metaEl = slot.querySelector('.chapter-meta');
            if (metaEl instanceof HTMLElement) {
              metaEl.hidden = !chapter.time && !chapter.location;
            }
            const descEl = slot.querySelector('[data-field="description"]');
            if (descEl) descEl.textContent = chapter.description ?? '';

            // REVEAL.md's map-dive: the destination coordinate/name/geometry
            // only ever exists in memory here, after this chapter's own
            // unlock check has already passed — never in the static HTML,
            // never in a locked API response (see revealData in
            // trip-state.ts). Doesn't start the sequence immediately: it
            // waits for #bestemming to actually scroll into view (see
            // armReveal below), same trigger the rest of the page already
            // uses for its own reveal animations.
            if (chapter.id === 'bestemming' && chapter.revealData) {
              armReveal(chapter.revealData);
            }
          }
        } catch (err) {
          console.error('Failed to load trip state', err);
        }
      }

      loadTripState();

      // --- REVEAL.md camera sequence (Ameland) --------------------------
      // Armed once (revealData arrives from loadTripState), but only
      // actually starts once #bestemming scrolls into view — a dedicated
      // observer, not the shared one below, so this stays fully decoupled
      // from the other chapters' own reveal timing.
      type RevealPayload = {
        coordinate: string;
        placeName: string;
        camera?: Record<string, ZoomPoint>;
        islandShape?: { d: string; tx: number; ty: number };
      };

      let revealArmed = false;

      function armReveal(revealData: RevealPayload): void {
        if (revealArmed) return;
        revealArmed = true;
        const bestemmingEl = document.getElementById('bestemming');
        if (!bestemmingEl) return;
        const trigger = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                initReveal(revealData);
                trigger.disconnect();
              }
            }
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
        );
        trigger.observe(bestemmingEl);
      }

      function initReveal(revealData: RevealPayload): void {
        if (!revealData.camera || !revealData.islandShape) {
          console.error('[reveal] unlocked but missing computed geometry — trip-state.ts should always attach this for vizier-europa');
          return;
        }
        const camera = revealData.camera;
        const diveLayer = document.querySelector<HTMLElement>('.hero-map-dive');
        const svgEl = document.querySelector<SVGSVGElement>('.hero-map-dive-svg');
        const zoomG = document.querySelector<SVGGElement>('.hero-map-dive-zoom');
        const motionG = document.querySelector<SVGGElement>('.hero-map-dive-motion');
        const scaleG = document.querySelector<SVGGElement>('.hero-map-dive-scale');
        const lod0El = document.getElementById('reveal-lod0');
        const lod1El = document.getElementById('reveal-lod1');
        const prologueEl = document.querySelector<HTMLElement>('.reveal-prologue');
        const telemetryEl = document.querySelector<HTMLElement>('[data-reveal-telemetry]');
        const stopEl = document.querySelector<HTMLElement>('[data-reveal-stop]');
        const stopNameEl = document.querySelector<HTMLElement>('[data-reveal-stop-name]');
        const stopSubEl = document.querySelector<HTMLElement>('[data-reveal-stop-sub]');
        const stopReasonEl = document.querySelector<HTMLElement>('[data-reveal-stop-reason]');
        const skipEl = document.querySelector<HTMLButtonElement>('[data-reveal-skip]');
        const debugEl = document.querySelector<HTMLElement>('[data-reveal-debug]');
        const chapterContent = document.querySelector<HTMLElement>('#bestemming .chapter-content');
        if (!diveLayer || !svgEl || !zoomG || !motionG || !scaleG || !prologueEl || !chapterContent) {
          console.error('[reveal] missing an expected element — see initReveal');
          return;
        }

        // The one point in the whole page where the destination island's
        // actual shape touches the DOM — built here, from the gated
        // payload only, once bestemming is confirmed unlocked. Appended
        // straight into lod1El (the same group nl-trace.ts's mainland
        // fragment renders in) rather than a separate group:
        // islandShape.tx/ty were recentered against that exact same
        // mainland origin (see island-trace.ts's header), so inheriting
        // lod1El's own translate(NL_CENTER) scale(NL_SCALE) transform is
        // what makes the island land at its true real-world position
        // relative to the coastline, with no separate fade timing needed
        // either — it's part of the same map, it just becomes visually
        // distinct as the camera dives toward it.
        //
        // Property/variable names avoid the destination's real name on
        // purpose, even here in a gated code path: this client `<script>`
        // block compiles into the page's JS bundle, which every visitor
        // downloads regardless of unlock state — an identifier literally
        // named after the destination would leak its name in that bundle's
        // source even while the actual geometry stays safely gated.
        if (lod1El) {
          const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          el.setAttribute('d', revealData.islandShape.d);
          el.setAttribute('transform', `translate(${revealData.islandShape.tx},${revealData.islandShape.ty})`);
          lod1El.appendChild(el);
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // localStorage, not sessionStorage: once bestemming is unlocked the
        // chapter moves to the top of the page, so the reveal is in view on
        // load rather than waiting for a scroll. Session-scoped state died
        // with the tab, which would have meant sitting through the sequence
        // (or waiting out the skip delay) on every single reopen. Per
        // browser is the right scope — a friend opening it for the first
        // time on their own phone still gets the moment.
        let alreadySeen = false;
        try {
          alreadySeen = localStorage.getItem('reveal-seen') === '1';
        } catch {
          // localStorage can throw in some private-browsing modes — treat as not-seen.
        }

        function markTextRevealed(instant: boolean): void {
          if (instant) {
            chapterContent!.querySelectorAll<HTMLElement>('.ct-eyebrow, .ct-title, .ct-copy, .ct-cta').forEach((el) => {
              el.style.transition = 'none';
              el.style.opacity = '1';
              el.style.transform = 'none';
            });
          } else {
            chapterContent!.classList.add('reveal-text-in');
          }
          try {
            localStorage.setItem('reveal-seen', '1');
          } catch {
            // best-effort only
          }
        }

        if (reducedMotion || alreadySeen) {
          markTextRevealed(true);
          return;
        }

        let cancelled = false;

        function sleep(ms: number): Promise<void> {
          return new Promise((resolve) => window.setTimeout(resolve, ms));
        }

        async function typePrologue(): Promise<void> {
          const line1 = prologueEl!.querySelector<HTMLElement>('[data-prologue="line1"]');
          const line2 = prologueEl!.querySelector<HTMLElement>('[data-prologue="line2"]');
          const line3 = prologueEl!.querySelector<HTMLElement>('[data-prologue="line3"]');
          if (!line1 || !line2 || !line3) return;

          const LOCK_TEXT = 'BESTEMMING VERGRENDELD';
          for (let i = 0; i <= LOCK_TEXT.length && !cancelled; i++) {
            line1.textContent = LOCK_TEXT.slice(0, i);
            await sleep(35);
          }
          await sleep(400);
          if (cancelled) return;

          // Cycling dots — a slightly irregular interval reads as a machine
          // working, not a CSS loop (REVEAL.md §3's own framing).
          const dotIntervals = [390, 410, 380, 420];
          let dotPhase = 0;
          const dotTimer = window.setInterval(() => {
            const dots = ['.', '..', '...', ''][dotPhase % 4];
            line2.textContent = `ONTSLEUTELEN${dots}`;
            dotPhase++;
          }, dotIntervals[dotPhase % dotIntervals.length]);

          // The coordinate resolving digit-by-digit matters more than the
          // dots (REVEAL.md is explicit about this) — masked with block
          // characters, progressively revealed left to right.
          const target = revealData.coordinate;
          const steps = 6;
          for (let i = 1; i <= steps && !cancelled; i++) {
            const revealCount = Math.round((target.length * i) / steps);
            let masked = '';
            for (let c = 0; c < target.length; c++) {
              masked += target[c] === ' ' ? ' ' : c < revealCount ? target[c] : '█';
            }
            line3.textContent = masked;
            await sleep(600);
          }
          if (!cancelled) line3.textContent = target;
          window.clearInterval(dotTimer);
          if (!cancelled) line2.textContent = 'ONTSLEUTELEN';
          await sleep(400);
        }

        type Point3 = ZoomPoint;
        function point(p: Point3) {
          return { x: p[0], y: p[1], w: p[2] };
        }
        function interpAt(p0: Point3, p1: Point3, t: number) {
          const i = interpolateZoom(p0, p1);
          const [x, y, w] = i(Math.max(0, Math.min(1, t)));
          return { x, y, w };
        }

        // Linear ramp from 0 at `edge0` to 1 at `edge1`, clamped — used to
        // crossfade LOD layers by current zoom level (see fadeInRange
        // in-out below) rather than by act/localT, so the fades stay
        // correct even while scroll-scrubbing back and forth.
        function ramp(edge0: number, edge1: number, x: number): number {
          if (edge0 === edge1) return x >= edge1 ? 1 : 0;
          return Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
        }
        function fadeInOut(x: number, inStart: number, inEnd: number, outStart: number, outEnd: number): number {
          return Math.min(ramp(inStart, inEnd, x), 1 - ramp(outStart, outEnd, x));
        }

        // Which rejected candidate the search is on, and how far into its own
        // 5 seconds. Each stop spends its first 40% travelling and the rest
        // held still — the hold is where the name, the coordinate and the
        // rejection get to land, so it has to be the longer half.
        const STOP_TRAVEL_FRACTION = 0.4;
        function stopStateAt(localT: number): { index: number; t: number } {
          const n = DECOY_STOPS.length;
          const scaled = Math.min(n - 0.0001, Math.max(0, localT * n));
          const index = Math.floor(scaled);
          return { index, t: scaled - index };
        }
        function stopPoint(stop: (typeof DECOY_STOPS)[number]): ZoomPoint {
          return [stop.x, stop.y, stop.w] as ZoomPoint;
        }

        function cameraAt(elapsedS: number): { x: number; y: number; w: number } {
          const { act, localT } = getActState(elapsedS);
          switch (act.id) {
            case 'prologue':
              return point(camera!.wide);
            case 'search': {
              const { index, t } = stopStateAt(localT);
              const from = index === 0 ? camera!.wide : stopPoint(DECOY_STOPS[index - 1]);
              const to = stopPoint(DECOY_STOPS[index]);
              const travel = Math.min(1, t / STOP_TRAVEL_FRACTION);
              return interpAt(from, to, travel);
            }
            case 'dive': {
              // Zwolle (the last rejection, already in the right country)
              // straight down onto the destination — one move, no
              // intermediate settle. It used to stage through 33x at the
              // halfway point, which put a pause in exactly the moment
              // that should just arrive somewhere.
              const from = stopPoint(DECOY_STOPS[DECOY_STOPS.length - 1]);
              return interpAt(from, camera!.islandDeep, localT);
            }
            default:
              return point(camera!.islandDeep);
          }
        }

        let startTime = 0;
        let lastFrameTime = 0;
        let rafId = 0;
        let scrub = { offsetS: 0, velocity: 0 };
        let firedImpact = false;
        // Which candidate's card is currently rendered, and which one has
        // already had its rejection fired — tracked separately so scrubbing
        // back and forth doesn't re-trigger the flash on every frame.
        let shownStopIndex = -1;
        let rejectedStopIndex = -1;
        const debugEnabled = new URLSearchParams(window.location.search).has('revealDebug');
        if (debugEnabled && debugEl) debugEl.classList.add('is-active');

        function onWheel(e: WheelEvent): void {
          const elapsedS = (performance.now() - startTime) / 1000 + scrub.offsetS;
          const { act } = getActState(elapsedS);
          if (!act.scrollScrubbed) return;
          e.preventDefault();
          scrub = pushScrubOffset(scrub, e.deltaY, 0.0015);
        }

        function tick(now: number): void {
          if (cancelled) return;
          const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
          lastFrameTime = now;
          scrub = stepScrubSpring(scrub, dt);

          const elapsedS = (now - startTime) / 1000 + scrub.offsetS;
          const { act, localT } = getActState(elapsedS);
          const { x, y, w } = cameraAt(elapsedS);

          const visualScale = camera!.wide[2] / w;
          // The SVG's own viewBox ("80 0 790 790") doesn't start at (0,0),
          // so translate(-x,-y) alone maps the target point to the
          // viewBox's top-left corner, not its center — a bug a screenshot
          // caught (the map rendering cropped into the top-left quadrant
          // instead of centered). Recentering to the viewBox's own center
          // (475, 395) after the scale fixes it.
          zoomG!.style.transformOrigin = '0 0';
          zoomG!.style.transform = `translate(475px, 395px) scale(${visualScale}) translate(${-x}px, ${-y}px)`;
          motionG!.style.transform = `translate(${x}px, ${y}px)`;
          scaleG!.style.transform = `scale(${1 / visualScale})`;
          // The reticle is up for the whole hunt, and for the first half of
          // the dive while the camera is still committing to a target.
          motionG!.style.opacity = act.id === 'search' || (act.id === 'dive' && localT < 0.5) ? '1' : '0';

          if (act.id === 'search') {
            const { index, t } = stopStateAt(localT);
            const stop = DECOY_STOPS[index];
            // Name/coordinate appear as the camera arrives; the rejection
            // lands at 70% so it reads as a verdict on something you've
            // already had a moment to hope about.
            const arrived = t >= STOP_TRAVEL_FRACTION;
            // 0.62 of a 6s stop is ~3.7s in, leaving ~2.3s to actually read
            // the verdict. At 0.7 the rejection landed so late in the slot
            // that it barely had time to register before the camera moved.
            const rejected = t >= 0.62;

            if (index !== shownStopIndex) {
              shownStopIndex = index;
              rejectedStopIndex = -1;
              if (stopNameEl) stopNameEl.textContent = stop.name;
              if (stopSubEl) stopSubEl.textContent = `${stop.country} · ${stop.coord}`;
              if (stopReasonEl) stopReasonEl.textContent = stop.reason;
              stopEl?.classList.remove('is-rejected');
            }
            stopEl?.classList.toggle('is-active', arrived);
            if (rejected && rejectedStopIndex !== index) {
              rejectedStopIndex = index;
              stopEl?.classList.add('is-rejected');
              svgEl!.classList.add('is-mismatch');
              window.setTimeout(() => svgEl!.classList.remove('is-mismatch'), 120);
              if (navigator.vibrate) navigator.vibrate([30, 50, 30]);
            }
          } else {
            stopEl?.classList.remove('is-active', 'is-rejected');
            shownStopIndex = -1;
            rejectedStopIndex = -1;
          }

          // The one real lock-on: the moment the dive commits to Ameland.
          if (act.id === 'dive' && localT >= 0.45 && !firedImpact) {
            firedImpact = true;
            svgEl!.classList.add('is-impact');
            window.setTimeout(() => svgEl!.classList.remove('is-impact'), 90);
            if (navigator.vibrate) navigator.vibrate(15);
          }

          // LOD crossfade by current zoom level, not by act — this is what
          // REVEAL.md §8 calls "Fase 2" and it was still missing: without
          // it, LOD0 (the wide Europe coastline) stayed at full opacity
          // through the ENTIRE zoom, meaning the deepest part of the dive
          // was rendering a coastline asset traced for a 1-6x view blown
          // up to 85x — that's the actual source of the blur reported
          // after watching this run, not a fixable rendering flag. Vector
          // content scaled 85x through a GPU-composited transform (the
          // only technique REVEAL.md's own §10 allows — animating viewBox
          // instead "forceert layout op elke frame", which is exactly the
          // per-device-jank risk §9's performance bar is guarding against)
          // will always soften at that multiple; the fix is to not still
          // BE looking at that same low-detail asset once it's 20+ zoom
          // levels past what it was drawn for.
          //
          // Thresholds were previously overlapping by design (LOD0 fading
          // out 5-12 while LOD1 faded in 3-5), on the theory that the
          // overlap would read as a crossfade. Screenshotted mid-dive, it
          // instead read as both layers fully on screen at once — the
          // Europe coastline still visible, unrelated coastline well
          // outside the Netherlands, behind an already-formed NL outline
          // ("Kan je [...] de europa SVG weghalen. Deze is nog steeds
          // zichtbaar").
          //
          // Rebuilt as a strict sequential handoff instead — LOD1's window
          // starts exactly where LOD0's ends, zero overlap, computed
          // against the actual dive zoom curve (Zwolle's 2.82x to
          // islandDeep's 45x over 8s):
          //   LOD0 (Europe coastline): full until 3x, fades out 3->4x,
          //     gone by 4x (~1.6s into the dive — search itself never
          //     exceeds 2.82x, so this never clips the hunt).
          //   LOD1 (NL sketch): starts fading in at 4x, the instant LOD0
          //     hits zero, full by 5x (~2.4s). No fadeout afterward — this
          //     is where the destination island's own traced shape gets
          //     appended too (see initReveal above), so LOD1 stays the
          //     reveal all the way to the dive's 45x end. The procedural
          //     tidal-channel network (LOD2) that used to fade in alongside
          //     it is gone entirely — it read as meaningless random
          //     squiggles, not real geography ("De random streepjes [...]
          //     slaat nergens op").
          const zoom = camera!.wide[2] / w;
          if (lod0El) (lod0El as unknown as HTMLElement).style.opacity = String(fadeInOut(zoom, 0, 0, 3, 4));
          if (lod1El) (lod1El as unknown as HTMLElement).style.opacity = String(ramp(4, 5, zoom));

          if (telemetryEl) {
            const altKm = Math.max(0, Math.round((w / camera!.wide[2]) * 8042));
            telemetryEl.textContent = `ALT ${altKm.toLocaleString('nl-NL')} km`;
          }
          if (debugEnabled && debugEl) {
            debugEl.textContent = `t=${elapsedS.toFixed(2)}s  act=${act.id}  localT=${localT.toFixed(2)}  w=${w.toFixed(1)}  scrub=${scrub.offsetS.toFixed(2)}`;
          }

          if (act.id === 'name' && localT >= 1) {
            finish();
            return;
          }
          rafId = requestAnimationFrame(tick);
        }

        function finish(): void {
          markTextRevealed(false);
          if (skipEl) skipEl.classList.remove('is-active');
          if (telemetryEl) telemetryEl.classList.remove('is-active');
          diveLayer!.style.opacity = '0';
        }

        function skip(): void {
          cancelled = true;
          cancelAnimationFrame(rafId);
          prologueEl!.classList.remove('is-active');
          diveLayer!.style.opacity = '0';
          markTextRevealed(true);
          if (skipEl) skipEl.classList.remove('is-active');
          if (telemetryEl) telemetryEl.classList.remove('is-active');
        }

        if (skipEl) {
          // Was 3000, chosen when the reveal only ever started because you
          // scrolled to it — a late button kept it off the prologue. Now it
          // can also fire unprompted on load (chapter sits at the top once
          // unlocked), so three seconds with no way out is too long for
          // someone who just wants to get back to the page.
          window.setTimeout(() => {
            if (!cancelled) skipEl.classList.add('is-active');
          }, 1000);
          skipEl.addEventListener('click', skip);
        }
        window.addEventListener('wheel', onWheel, { passive: false });

        prologueEl.classList.add('is-active');
        void typePrologue().then(() => {
          if (cancelled) return;
          prologueEl!.classList.remove('is-active');
          diveLayer!.style.transition = 'opacity 500ms ease';
          diveLayer!.style.opacity = '1';
          if (telemetryEl) telemetryEl.classList.add('is-active');
          // typePrologue() above IS this sequence's Act 0 — back-date
          // startTime so the rAF loop's own elapsedS starts at Act 1
          // (5.0s) instead of replaying ACTS[0]'s 5-second wide-Europe
          // hold a second time with nothing happening on screen.
          startTime = performance.now() - 5000;
          lastFrameTime = performance.now();
          rafId = requestAnimationFrame(tick);
        });
      }

      // Installeren toggle (ported from Main.dc.html's pickAndroid/pickIOS
      // setState calls): plain DOM attribute toggling instead of component
      // state, since this page has no client component runtime. Setting
      // data-platform on the container alone drives both the button and
      // instruction-block visual states via the CSS attribute-selector
      // pairs in <style> above — no class list to keep in sync per element.
      const installerenSection = document.getElementById('installeren');
      if (installerenSection) {
        const platformButtons =
          installerenSection.querySelectorAll<HTMLButtonElement>('[data-platform-btn]');
        platformButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const platform = button.dataset.platformBtn;
            if (!platform) return;
            installerenSection.dataset.platform = platform;
            platformButtons.forEach((btn) => {
              btn.setAttribute('aria-pressed', String(btn.dataset.platformBtn === platform));
            });
          });
        });
      }

      // Paklijst (story 9): checked state is client-only, per-device
      // (AD-6) — one JSON blob per trip, `packingChecked:{tripSlug}` ->
      // {[itemId]: boolean}, never sent to the server. All localStorage
      // reads/writes are wrapped in try/catch and swallowed silently (same
      // graceful-degradation convention as the service-worker registration
      // below) so private-mode/storage-disabled browsers still render a
      // fully clickable checklist, just without persistence.
      const packingToggleButton = document.getElementById('packing-toggle');
      const packingOverlay = document.getElementById('packing-overlay');
      const packingCloseButton = document.getElementById('packing-close');

      function packingStorageKey(): string | null {
        return tripSlug ? `packingChecked:${tripSlug}` : null;
      }

      function readPackingChecked(): Record<string, boolean> {
        const key = packingStorageKey();
        if (!key) return {};
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return {};
          const parsed = JSON.parse(raw);
          return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
        } catch {
          return {};
        }
      }

      function writePackingChecked(state: Record<string, boolean>): void {
        const key = packingStorageKey();
        if (!key) return;
        try {
          localStorage.setItem(key, JSON.stringify(state));
        } catch {
          // Swallow — private mode / storage disabled. The checklist stays
          // fully interactive this session, it just won't persist.
        }
      }

      if (packingToggleButton && packingOverlay) {
        const packingCheckboxes =
          packingOverlay.querySelectorAll<HTMLInputElement>('.packing-checkbox');

        // Initial-load snapshot only, to paint the starting checked state —
        // never mutated in place afterwards. The change handler below
        // re-reads fresh from localStorage at write time instead of
        // reusing this variable, so a second tab open on the same trip
        // can't silently revert this tab's writes with a stale in-memory
        // copy of every other item (the same read-modify-write race AD-6
        // was written to rule out, just across tabs instead of the server).
        const initialPackingChecked = readPackingChecked();

        packingCheckboxes.forEach((checkbox) => {
          const id = checkbox.dataset.packingId;
          if (id && initialPackingChecked[id]) checkbox.checked = true;
          checkbox.addEventListener('change', () => {
            if (!id) return;
            const currentPackingChecked = readPackingChecked();
            currentPackingChecked[id] = checkbox.checked;
            writePackingChecked(currentPackingChecked);
          });
        });

        function openPacking(): void {
          packingOverlay!.hidden = false;
          packingToggleButton!.setAttribute('aria-expanded', 'true');
          packingCloseButton?.focus();
        }

        function closePacking(): void {
          packingOverlay!.hidden = true;
          packingToggleButton!.setAttribute('aria-expanded', 'false');
          packingToggleButton!.focus();
        }

        packingToggleButton.addEventListener('click', openPacking);
        packingCloseButton?.addEventListener('click', closePacking);

        // Backdrop click closes (mockup's onClick={closePaklijst} on the
        // outer overlay div + onClick={stop} on the sheet): only a direct
        // click on the overlay element itself (the backdrop) counts — a
        // click on the sheet or its children targets a descendant, not the
        // overlay, so it never reaches this branch.
        packingOverlay.addEventListener('click', (event) => {
          if (event.target === packingOverlay) closePacking();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !packingOverlay!.hidden) {
            closePacking();
          }
        });
      }

      // Service worker registration (required for Chrome/Android
      // installability). Guarded per the acceptance criteria: unsupported
      // browsers skip registration silently, no console error, no
      // user-facing failure — the toggle above still works regardless.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch((err) => {
          console.error('Service worker registration failed', err);
        });

        // Re-fetch + re-render on the service worker's push-triggered
        // broadcast (AD-4): `push`'s handler in sw.js posts this message to
        // every open client instead of transporting state itself, so a
        // dropped/offline push can't leave this tab stale once it
        // reconnects — loadTripState() is the same render path the initial
        // page load already uses.
        navigator.serviceWorker.addEventListener('message', (event) => {
          if (event.data && event.data.type === 'trip-updated') {
            loadTripState();
          }
        });
      }

      // Meldingen aanzetten (story 8, AD-4): guest opt-in control near
      // #installeren. Every outcome shows its own explicit message —
      // unsupported browser, missing VAPID key, permission denied, already
      // subscribed, subscribe failure, success — never a silent no-op, and
      // a denied permission is checked up front so a repeat click never
      // re-triggers the browser's permission prompt.
      const notifyControls = document.getElementById('notify-controls');
      const notifyButton = document.getElementById('notify-subscribe-button');
      const notifyMessage = document.getElementById('notify-message');

      function showNotifyMessage(text: string): void {
        if (!(notifyMessage instanceof HTMLElement)) return;
        notifyMessage.textContent = text;
        notifyMessage.hidden = false;
      }

      function urlBase64ToUint8Array(base64String: string): Uint8Array<ArrayBuffer> {
        const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
        const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        const rawData = window.atob(base64);
        // Constructed from an explicit ArrayBuffer (not a bare length) so
        // the result types as Uint8Array<ArrayBuffer>, matching
        // pushManager.subscribe's applicationServerKey (BufferSource)
        // expectation exactly under TS's typed-array generics.
        const outputArray = new Uint8Array(new ArrayBuffer(rawData.length));
        for (let i = 0; i < rawData.length; i++) {
          outputArray[i] = rawData.charCodeAt(i);
        }
        return outputArray;
      }

      async function subscribeToPushNotifications(): Promise<void> {
        if (!('Notification' in window) || !('serviceWorker' in navigator) || !('PushManager' in window)) {
          showNotifyMessage('Meldingen worden niet ondersteund op dit toestel.');
          return;
        }

        const vapidKey = notifyControls instanceof HTMLElement ? notifyControls.dataset.vapidKey : undefined;
        if (!vapidKey) {
          showNotifyMessage('Meldingen zijn nu niet beschikbaar. Probeer het later opnieuw.');
          return;
        }

        // Checked up front: once a guest has blocked notifications, calling
        // requestPermission() again cannot show the prompt again either —
        // this just makes that state explicit instead of silently no-op-ing.
        if (Notification.permission === 'denied') {
          showNotifyMessage(
            'Je hebt meldingen geblokkeerd. Zet dit aan via je browser- of toestelinstellingen om updates te ontvangen.',
          );
          return;
        }

        try {
          const registration = await navigator.serviceWorker.ready;

          const existingSubscription = await registration.pushManager.getSubscription();
          if (existingSubscription) {
            showNotifyMessage('Meldingen staan al aan op dit toestel.');
            return;
          }

          const permission = await Notification.requestPermission();
          if (permission !== 'granted') {
            showNotifyMessage(
              'Je hebt meldingen geblokkeerd. Zet dit aan via je browser- of toestelinstellingen om updates te ontvangen.',
            );
            return;
          }

          const subscription = await registration.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(vapidKey),
          });

          const res = await fetch('/api/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tripSlug, ...subscription.toJSON() }),
          });
          const payload = await res.json();

          if (!res.ok || !payload.ok) {
            showNotifyMessage('Meldingen aanzetten is niet gelukt. Probeer het later opnieuw.');
            return;
          }

          showNotifyMessage('Meldingen staan aan. Je krijgt een seintje zodra er een hoofdstuk opengaat.');
        } catch (err) {
          console.error('Failed to subscribe to push notifications', err);
          showNotifyMessage('Meldingen aanzetten is niet gelukt. Probeer het later opnieuw.');
        }
      }

      notifyButton?.addEventListener('click', () => {
        void subscribeToPushNotifications();
      });
    </script>
  </body>
</html>
