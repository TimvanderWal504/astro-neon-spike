    <!-- CHAPTER SLOTS — only id/order/kind drive this markup. Each slot
         stays display:none (see .chapter-slot) until client-side JS adds
         .is-unlocked, so a locked chapter has no visible trace at all —
         real content (title/time/location/description) is filled in only
         once the fetch of /api/trip/[slug] reports it unlocked, never
         embedded here. -->
    <div class="chapters">
      {
        chapterSlots.map((chapter) => {
          const isCinematic = chapter.kind === 'cinematic';
          return (
            <section
              class={`chapter-slot ${isCinematic ? 'cinematic-reveal' : 'reveal'}`}
              id={chapter.id}
              data-order={chapter.order}
              data-kind={chapter.kind}
            >
              <div class="chapter-index mono">{String(chapter.order).padStart(2, '0')}</div>
              {isCinematic ? (
                <div class="chapter-content">
                  <p class="chapter-meta ct-eyebrow">
                    <span data-field="time" /> <span data-field="location" />
                  </p>
                  <h2 class="chapter-title ct-title" data-field="title" />
                  <p class="chapter-description ct-copy" data-field="description" />
                  <button type="button" class="chapter-replay ct-cta" data-replay-target={chapter.id}>
                    Bekijk opnieuw
                  </button>
                </div>
              ) : (
                <div class="chapter-content">
                  <h2 class="chapter-title" data-field="title" />
                  <p class="chapter-meta">
                    <span data-field="time" /> <span data-field="location" />
                  </p>
                  <p class="chapter-description" data-field="description" />
                </div>
              )}
            </section>
          );
        })
      }
    </div>

    <script>
      // daysLeft is always computed fresh, client-side, from the static
      // `data-start` attribute — never baked in once at build time, so a
      // static build never goes stale (mirrors Main.dc.html's formula).
      const body = document.body;
      const startISO = body.dataset.start;
      const tripSlug = body.dataset.tripSlug;

      // Set once #bestemming's reveal observer fires (see IntersectionObserver
      // setup below) — stops startViewfinderWander's recursive step() so an
      // un-stopped tick can't resume overwriting the ambient map's inline
      // transform style after the dive sequence's CSS animation ends.
      let wanderStopped = false;

      function computeDaysLeft(): number {
        const target = new Date(startISO ?? '');
        const now = new Date();
        return Math.max(0, Math.ceil((target.getTime() - now.getTime()) / 86400000));
      }

      function renderDaysLeft(): void {
        const daysLeft = String(computeDaysLeft());
        document.querySelectorAll('[data-days-left]').forEach((el) => {
          el.textContent = daysLeft;
        });
      }

      renderDaysLeft();

      // Viewfinder wander: a random walk over the landmass area of the
      // 800x800 map (roughly Western/Central Europe, anchored near the
      // Netherlands) instead of a fixed CSS keyframe loop, so the motion
      // never repeats the same path twice. Skipped entirely under
      // prefers-reduced-motion, settling on the NL anchor point instead.
      function startViewfinderWander(): void {
        const motionEl = document.querySelector<SVGGElement>('.hero-map-motion');
        const scaleEl = document.querySelector<SVGGElement>('.hero-map-scale');
        if (!motionEl || !scaleEl) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          motionEl.style.transform = 'translate(305px, 335px)';
          scaleEl.style.transform = 'scale(1.08)';
          return;
        }

        const X_MIN = 150;
        const X_MAX = 520;
        const Y_MIN = 300;
        const Y_MAX = 580;
        const SCALE_MIN = 0.9;
        const SCALE_MAX = 1.25;
        const MOVE_MS_MIN = 2200;
        const MOVE_MS_MAX = 4200;
        const PAUSE_MS_MIN = 300;
        const PAUSE_MS_MAX = 900;

        const randomBetween = (min: number, max: number) => min + Math.random() * (max - min);

        function step(): void {
          if (wanderStopped) return;

          const x = randomBetween(X_MIN, X_MAX);
          const y = randomBetween(Y_MIN, Y_MAX);
          const scale = randomBetween(SCALE_MIN, SCALE_MAX);
          const durationMs = randomBetween(MOVE_MS_MIN, MOVE_MS_MAX);

          motionEl!.style.transitionDuration = `${durationMs}ms`;
          scaleEl!.style.transitionDuration = `${durationMs}ms`;
          motionEl!.style.transform = `translate(${x}px, ${y}px)`;
          scaleEl!.style.transform = `scale(${scale})`;

          setTimeout(step, durationMs + randomBetween(PAUSE_MS_MIN, PAUSE_MS_MAX));
        }

        // First placement jumps in instantly (no transition) so it doesn't
        // glide in from the SVG origin on page load.
        motionEl.style.transitionDuration = '0s';
        scaleEl.style.transitionDuration = '0s';
        motionEl.style.transform = 'translate(305px, 335px)';
        scaleEl.style.transform = 'scale(1.08)';
        requestAnimationFrame(step);
      }

      startViewfinderWander();

      // Reveal / cinematic choreography (ported unchanged from
      // Main.dc.html's componentDidMount): the observer is created and
      // observes every .reveal/.reveal-fade/.cinematic-reveal element
      // synchronously here, independent of loadTripState()'s async fetch — a
      // locked chapter's slot already carries its reveal class server-side
      // (see chapter-slot markup above), it's just display:none until
      // unlocked, so it's observed from the start.
      const revealTargets = document.querySelectorAll('.reveal, .reveal-fade, .cinematic-reveal');
      const prefersReducedMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (typeof IntersectionObserver === 'undefined' || prefersReducedMotion) {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
        wanderStopped = true;
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
                if (entry.target.id === 'bestemming') {
                  wanderStopped = true;
                }
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
        );
        revealTargets.forEach((el) => revealObserver.observe(el));
      }

      // Replay ("Bekijk opnieuw"): remove then re-add .is-visible on the
      // chapter's own reveal/cinematic-reveal element so its CSS
      // transitions retrigger from the start (and, for Bestemming, the dive
      // layer along with it, since both key off the same
      // body:has(#bestemming.is-visible) trigger).
      document.querySelectorAll<HTMLButtonElement>('[data-replay-target]').forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.dataset.replayTarget;
          const target = targetId ? document.getElementById(targetId) : null;
          if (!target) return;
          if (targetId === 'bestemming') wanderStopped = true;
          target.classList.remove('is-visible');
          void target.offsetWidth;
          requestAnimationFrame(() => target.classList.add('is-visible'));
        });
      });

      // Merge real content into unlocked chapter slots via the redacted
      // trip-state API (AD-2). Locked chapters are never touched — they
      // stay display:none (see .chapter-slot), invisible until unlocked.
      async function loadTripState(): Promise<void> {
        if (!tripSlug) return;
        try {
          const res = await fetch(`/api/trip/${encodeURIComponent(tripSlug)}`);
          const payload = await res.json();
          if (!payload.ok) return;

          const chapters = payload.data?.chapters ?? [];
          for (const chapter of chapters) {
            if (!chapter.unlocked) continue;
            const slot = document.getElementById(chapter.id);
            if (!slot) continue;

            slot.classList.add('is-unlocked');
            const titleEl = slot.querySelector('[data-field="title"]');
            if (titleEl) titleEl.textContent = chapter.title;
            const timeEl = slot.querySelector('[data-field="time"]');
            if (timeEl) timeEl.textContent = chapter.time ?? '';
            const locationEl = slot.querySelector('[data-field="location"]');
            if (locationEl) locationEl.textContent = chapter.location ?? '';
            const metaEl = slot.querySelector('.chapter-meta');
            if (metaEl instanceof HTMLElement) {
              metaEl.hidden = !chapter.time && !chapter.location;
            }
            const descEl = slot.querySelector('[data-field="description"]');
            if (descEl) descEl.textContent = chapter.description ?? '';
          }
        } catch (err) {
          console.error('Failed to load trip state', err);
        }
      }

      loadTripState();
    </script>
  </body>
</html>
