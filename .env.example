# Copy this file to .env and fill in real values. Never commit .env.
# See SETUP.md for the full walkthrough of where each value comes from.

# Neon Postgres connection string (dev branch locally, prod branch in Vercel's
# prod env). Provisioned via the Vercel Marketplace Neon integration (AD-9).
# Story: 1 (this story) — src/lib/db.ts reads it lazily via getSql().
DATABASE_URL=

# Shared organizer passcode that gates /[trip]/admin (AD-5). Generate with:
#   openssl rand -base64 32
# Story: 4 — admin passcode-check route.
ADMIN_PASSCODE=

# Secret used to sign the httpOnly admin session cookie (AD-5). Generate with:
#   openssl rand -base64 32
# Story: 4 — admin passcode-check route / session cookie.
COOKIE_SIGNING_SECRET=

# VAPID keypair for Web Push (AD-4, via PushForge). Generate both at once with:
#   pnpm dlx web-push generate-vapid-keys
# Story: 8 — push subscribe route + service worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
